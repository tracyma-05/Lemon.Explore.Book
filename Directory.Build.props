<Project>

  <!-- Auto-imported by every project in the repository. -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Product>Lemon Explore Book</Product>
    <Authors>Tracy Ma</Authors>
    <Copyright>Copyright (c) 2026 Tracy Ma</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit findings stay warnings: a new advisory must not turn a green build red with no source change. -->
    <WarningsNotAsErrors>NU1507;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
