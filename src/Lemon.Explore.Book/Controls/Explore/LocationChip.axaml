<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
             xmlns:places="using:Lemon.Explore.Book.Explore.Places"
             x:Class="Lemon.Explore.Book.Controls.Explore.LocationChip">
    <!--
        The observer location shared by the chapters that depend on where you are. Sits on a chapter's left page;
        clicking it opens the picker. The chapter itself follows IExploreLocationService.Changed.
    -->
    <UserControl.Styles>
        <Style Selector="FlyoutPresenter.location">
            <Setter Property="Background" Value="#FBF7EF" />
            <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,4,16,16" />
            <Setter Property="Width" Value="380" />
            <Setter Property="MaxWidth" Value="380" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="Button#Chip">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="#10B5532E" />
            <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button#Chip:pointerover /template/ Border#Chrome">
            <Setter Property="Background" Value="#1CB5532E" />
        </Style>
        <Style Selector="Button#Chip:focus-visible /template/ Border#Chrome">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
    </UserControl.Styles>

    <Button x:Name="Chip" x:DataType="places:ExploreLocationPickerViewModel"
            ToolTip.Tip="{loc:Localize Location_Chip_Tooltip}"
            AutomationProperties.Name="{loc:Localize Location_Title}">
        <DockPanel>
            <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0"
                      Foreground="{StaticResource AccentBrush}" Data="{StaticResource Icon.Pin}" />
            <PathIcon DockPanel.Dock="Right" Width="14" Height="14" Margin="6,0,0,0"
                      Foreground="{StaticResource FaintInkBrush}" Data="{StaticResource Icon.ChevronDown}" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12.5" Margin="10,0,0,0"
                       Foreground="{StaticResource FaintInkBrush}" Text="{loc:Localize Location_Change}" />
            <TextBlock VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis">
                <Run Text="{loc:Localize Location_Short}" Foreground="{StaticResource FaintInkBrush}" />
                <Run Text=" " />
                <Run Text="{Binding ChipText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </DockPanel>

        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="location">
                <StackPanel x:DataType="places:ExploreLocationPickerViewModel">
                    <TextBlock Classes="caption" Text="{loc:Localize Location_Title}" />
                    <TextBlock Classes="note" Margin="0,0,0,10" Text="{loc:Localize Location_Description}" />

                    <ListBox Classes="chips" ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedPlace}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="places:ExplorePlaceOption">
                                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding CoordinatesText}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="ExploreLocationCustom" IsChecked="{Binding IsCustom}"
                                     Content="{loc:Localize Location_City_Custom}" />
                    </WrapPanel>

                    <!-- Custom point -->
                    <TextBlock Classes="caption" Text="{loc:Localize Location_Custom_Caption}" />
                    <DockPanel>
                        <TextBlock Classes="value" Text="{Binding CustomLatitude, StringFormat={}{0:0.0}°}" />
                        <TextBlock Classes="note" Text="{loc:Localize Location_Latitude}" />
                    </DockPanel>
                    <Slider Minimum="-90" Maximum="90" SmallChange="0.1" LargeChange="5" Value="{Binding CustomLatitude}"
                            AutomationProperties.Name="{loc:Localize Location_Latitude}" />
                    <DockPanel>
                        <TextBlock Classes="value" Text="{Binding CustomLongitude, StringFormat={}{0:0.0}°}" />
                        <TextBlock Classes="note" Text="{loc:Localize Location_Longitude}" />
                    </DockPanel>
                    <Slider Minimum="-180" Maximum="180" SmallChange="0.1" LargeChange="5" Value="{Binding CustomLongitude}"
                            AutomationProperties.Name="{loc:Localize Location_Longitude}" />
                    <TextBlock Classes="note" Margin="0,2,0,10" Text="{Binding CustomText}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding UseCustomCommand}" Content="{loc:Localize Location_Custom_Use}" />
                        <Button Classes="chip" Command="{Binding CopyCurrentCommand}" Content="{loc:Localize Location_Custom_FromCurrent}" />
                    </WrapPanel>

                    <Rectangle Height="1" Margin="0,12,0,10" Fill="{StaticResource ChipBorderBrush}" />
                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}">
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  " />
                        <Run Text="{Binding CoordinatesText, Mode=OneWay}" Foreground="{StaticResource BodyInkBrush}" />
                    </TextBlock>
                    <TextBlock Classes="note" Margin="0,4,0,0" Text="{Binding DetailsText}" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
