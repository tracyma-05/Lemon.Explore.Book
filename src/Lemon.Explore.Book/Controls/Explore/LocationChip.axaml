<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
             xmlns:places="using:Lemon.Explore.Book.Explore.Places"
             xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
             x:Class="Lemon.Explore.Book.Controls.Explore.LocationChip">
    <!--
        The observer location shared by the chapters that depend on where you are. Sits on a chapter's left page;
        clicking it opens the picker (also in the settings). The chapter itself follows IExploreLocationService.Changed.
    -->
    <UserControl.Styles>
        <Style Selector="Button#Chip">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button#Chip:pointerover /template/ Border#Chrome">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button#Chip:focus-visible /template/ Border#Chrome">
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
        </Style>
    </UserControl.Styles>

    <Button x:Name="Chip" x:DataType="places:ExploreLocationPickerViewModel"
            ToolTip.Tip="{loc:Localize Location_Chip_Tooltip}"
            AutomationProperties.Name="{loc:Localize Location_Title}">
        <DockPanel>
            <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0"
                      Foreground="{DynamicResource AccentBrush}" Data="{StaticResource Icon.Pin}" />
            <PathIcon DockPanel.Dock="Right" Width="14" Height="14" Margin="6,0,0,0"
                      Foreground="{DynamicResource FaintInkBrush}" Data="{StaticResource Icon.ChevronDown}" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12.5" Margin="10,0,0,0"
                       Foreground="{DynamicResource FaintInkBrush}" Text="{loc:Localize Location_Change}" />
            <TextBlock VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis">
                <Run Text="{loc:Localize Location_Short}" Foreground="{DynamicResource FaintInkBrush}" />
                <Run Text=" " />
                <Run Text="{Binding ChipText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </DockPanel>

        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="paper">
                <StackPanel>
                    <TextBlock Classes="caption" Text="{loc:Localize Location_Title}" />
                    <explore:LocationPickerView />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
