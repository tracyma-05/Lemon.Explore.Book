<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lemon.Explore.Book.ViewModels.Pages"
             xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
             x:Class="Lemon.Explore.Book.Views.Pages.BackCoverPageView"
             x:DataType="pages:BackCoverPageViewModel"
             Background="{StaticResource CoverBrush}">
    <Grid RowDefinitions="*,Auto,*" Margin="48">
        <TextBlock Grid.Row="1" Classes="coverText" FontSize="24" Foreground="{StaticResource CoverGoldBrush}"
                   Text="{loc:Localize BackCover_Text}" />
    </Grid>
</UserControl>
