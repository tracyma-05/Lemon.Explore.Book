<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lemon.Explore.Book.ViewModels"
             xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
             x:Class="Lemon.Explore.Book.Views.BookmarksView"
             x:DataType="vm:BookmarksViewModel">
    <!-- The bookmarks, opened from the toolbar: mark the reading page, and the marked pages to turn to. -->
    <UserControl.Styles>
        <Style Selector="Button.bookmark">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.bookmark:pointerover /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
        </Style>
        <Style Selector="Button.bookmark:focus-visible /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <TextBlock Classes="kicker" Margin="0,12,0,0" Text="{loc:Localize Bookmarks_Title}" />

        <!-- The reading page -->
        <TextBlock Classes="note" Margin="0,8,0,6" Text="{Binding CurrentCaption}" />
        <ToggleButton Classes="chip" HorizontalAlignment="Left" IsChecked="{Binding IsCurrentMarked, Mode=OneWay}"
                      Command="{Binding ToggleCurrentCommand}" ToolTip.Tip="{loc:Localize Bookmarks_Shortcut}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Bookmark}" />
                <TextBlock Text="{Binding ToggleText}" />
            </StackPanel>
        </ToggleButton>

        <Rectangle Height="1" Margin="0,8,0,8" Fill="{DynamicResource ChipBorderBrush}" />

        <TextBlock Classes="note" IsVisible="{Binding !HasItems}" Text="{loc:Localize Bookmarks_Empty}" />
        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasItems}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BookmarkEntry">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="bookmark" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Caption}">
                                <DockPanel>
                                    <PathIcon DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top"
                                              Foreground="{DynamicResource AccentBrush}" Data="{StaticResource Icon.Bookmark}" />
                                    <StackPanel>
                                        <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" Text="{Binding Caption}" />
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource FaintInkBrush}" Text="{Binding Details}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="bookmark" Width="32" Height="32" Padding="8" VerticalAlignment="Center"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="{loc:Localize Bookmarks_RemoveOne}"
                                    AutomationProperties.Name="{loc:Localize Bookmarks_RemoveOne}">
                                <PathIcon Width="12" Height="12" Foreground="{DynamicResource FaintInkBrush}" Data="{StaticResource Icon.Close}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
