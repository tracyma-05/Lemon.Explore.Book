<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Lemon.Explore.Book.ViewModels"
             xmlns:views="using:Lemon.Explore.Book.Views"
             xmlns:pages="using:Lemon.Explore.Book.ViewModels.Pages"
             xmlns:pageViews="using:Lemon.Explore.Book.Views.Pages"
             xmlns:controls="using:Lemon.Explore.Book.Controls"
             xmlns:seasons="using:Lemon.Explore.Book.Chapters.Seasons"
             xmlns:solar="using:Lemon.Explore.Book.Chapters.SolarSystem"
             xmlns:eclipses="using:Lemon.Explore.Book.Chapters.Eclipses"
             xmlns:moon="using:Lemon.Explore.Book.Chapters.MoonPhases"
             xmlns:daynight="using:Lemon.Explore.Book.Chapters.DayNight"
             xmlns:tides="using:Lemon.Explore.Book.Chapters.Tides"
             xmlns:kepler="using:Lemon.Explore.Book.Chapters.Kepler"
             xmlns:startrails="using:Lemon.Explore.Book.Chapters.StarTrails"
             xmlns:retrograde="using:Lemon.Explore.Book.Chapters.Retrograde"
             xmlns:starlife="using:Lemon.Explore.Book.Chapters.StarLife"
             xmlns:blackhole="using:Lemon.Explore.Book.Chapters.BlackHole"
             xmlns:expansion="using:Lemon.Explore.Book.Chapters.Expansion"
             xmlns:watercycle="using:Lemon.Explore.Book.Chapters.WaterCycle"
             xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="Lemon.Explore.Book.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#2A1D15">

    <!--
        One view per page type; BookView's presenters pick them up from here. The first match wins, so a ported
        chapter's page types (subclasses of the placeholder pages) come first.
    -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="solar:SolarSystemTextPageViewModel"><solar:SolarSystemTextPageView /></DataTemplate>
        <DataTemplate DataType="solar:SolarSystemDiagramPageViewModel"><solar:SolarSystemDiagramPageView /></DataTemplate>
        <DataTemplate DataType="eclipses:EclipseTextPageViewModel"><eclipses:EclipseTextPageView /></DataTemplate>
        <DataTemplate DataType="eclipses:EclipseDiagramPageViewModel"><eclipses:EclipseDiagramPageView /></DataTemplate>
        <DataTemplate DataType="moon:MoonPhasesTextPageViewModel"><moon:MoonPhasesTextPageView /></DataTemplate>
        <DataTemplate DataType="moon:MoonPhasesDiagramPageViewModel"><moon:MoonPhasesDiagramPageView /></DataTemplate>
        <DataTemplate DataType="daynight:DayNightTextPageViewModel"><daynight:DayNightTextPageView /></DataTemplate>
        <DataTemplate DataType="daynight:DayNightDiagramPageViewModel"><daynight:DayNightDiagramPageView /></DataTemplate>
        <DataTemplate DataType="tides:TidesTextPageViewModel"><tides:TidesTextPageView /></DataTemplate>
        <DataTemplate DataType="tides:TidesDiagramPageViewModel"><tides:TidesDiagramPageView /></DataTemplate>
        <DataTemplate DataType="kepler:KeplerTextPageViewModel"><kepler:KeplerTextPageView /></DataTemplate>
        <DataTemplate DataType="kepler:KeplerDiagramPageViewModel"><kepler:KeplerDiagramPageView /></DataTemplate>
        <DataTemplate DataType="seasons:SeasonsTextPageViewModel"><seasons:SeasonsTextPageView /></DataTemplate>
        <DataTemplate DataType="seasons:SeasonsDiagramPageViewModel"><seasons:SeasonsDiagramPageView /></DataTemplate>

        <DataTemplate DataType="startrails:StarTrailsTextPageViewModel"><startrails:StarTrailsTextPageView /></DataTemplate>
        <DataTemplate DataType="startrails:StarTrailsDiagramPageViewModel"><startrails:StarTrailsDiagramPageView /></DataTemplate>
        <DataTemplate DataType="retrograde:RetrogradeTextPageViewModel"><retrograde:RetrogradeTextPageView /></DataTemplate>
        <DataTemplate DataType="retrograde:RetrogradeDiagramPageViewModel"><retrograde:RetrogradeDiagramPageView /></DataTemplate>
        <DataTemplate DataType="starlife:StarLifeTextPageViewModel"><starlife:StarLifeTextPageView /></DataTemplate>
        <DataTemplate DataType="starlife:StarLifeDiagramPageViewModel"><starlife:StarLifeDiagramPageView /></DataTemplate>
        <DataTemplate DataType="blackhole:BlackHoleTextPageViewModel"><blackhole:BlackHoleTextPageView /></DataTemplate>
        <DataTemplate DataType="blackhole:BlackHoleDiagramPageViewModel"><blackhole:BlackHoleDiagramPageView /></DataTemplate>
        <DataTemplate DataType="expansion:ExpansionTextPageViewModel"><expansion:ExpansionTextPageView /></DataTemplate>
        <DataTemplate DataType="expansion:ExpansionDiagramPageViewModel"><expansion:ExpansionDiagramPageView /></DataTemplate>
        <DataTemplate DataType="watercycle:WaterCycleTextPageViewModel"><watercycle:WaterCycleTextPageView /></DataTemplate>
        <DataTemplate DataType="watercycle:WaterCycleDiagramPageViewModel"><watercycle:WaterCycleDiagramPageView /></DataTemplate>
        <DataTemplate DataType="pages:CoverPageViewModel"><pageViews:CoverPageView /></DataTemplate>
        <DataTemplate DataType="pages:HowToUsePageViewModel"><pageViews:HowToUsePageView /></DataTemplate>
        <DataTemplate DataType="pages:TitlePageViewModel"><pageViews:TitlePageView /></DataTemplate>
        <DataTemplate DataType="pages:ContentsPageViewModel"><pageViews:ContentsPageView /></DataTemplate>
        <DataTemplate DataType="pages:ChapterTextPageViewModel"><pageViews:ChapterTextPageView /></DataTemplate>
        <DataTemplate DataType="pages:ChapterDiagramPageViewModel"><pageViews:ChapterDiagramPageView /></DataTemplate>
        <DataTemplate DataType="pages:CreditsPageViewModel"><pageViews:CreditsPageView /></DataTemplate>
        <DataTemplate DataType="pages:BackCoverPageViewModel"><pageViews:BackCoverPageView /></DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding Bookmarks.ToggleCurrentCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <!--
            The toolbar is also the window's title bar on the desktop (MainWindow extends the book into it): drag it to
            move the window, double-click to maximize, and on Windows 11 hover the maximize button for snap layouts.
            ElementRole tells the system which part is which; the book's own buttons are "User" so they stay clickable.
        -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Classes="toolbar" WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="TitleText" Classes="toolbarTitle" Text="{loc:Localize App_Title}" />
                <!-- Minimize, maximize / restore and close: shown by MainWindow on Windows and Linux. -->
                <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" Margin="10,-6,-12,-6"
                            IsVisible="False">
                    <Button Classes="caption" Click="OnMinimizeClick"
                            ToolTip.Tip="{loc:Localize Window_Minimize}" AutomationProperties.Name="{loc:Localize Window_Minimize}"
                            WindowDecorationProperties.ElementRole="MinimizeButton">
                        <PathIcon Data="{StaticResource Icon.WindowMinimize}" />
                    </Button>
                    <Button Classes="caption" Click="OnMaximizeClick"
                            ToolTip.Tip="{loc:Localize Window_Maximize}" AutomationProperties.Name="{loc:Localize Window_Maximize}"
                            WindowDecorationProperties.ElementRole="MaximizeButton">
                        <PathIcon x:Name="MaximizeIcon" Data="{StaticResource Icon.WindowMaximize}" />
                    </Button>
                    <Button Classes="caption close" Click="OnCloseClick"
                            ToolTip.Tip="{loc:Localize Window_Close}" AutomationProperties.Name="{loc:Localize Window_Close}"
                            WindowDecorationProperties.ElementRole="CloseButton">
                        <PathIcon Data="{StaticResource Icon.WindowClose}" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="toolbarButtons" Orientation="Horizontal" Spacing="6"
                            WindowDecorationProperties.ElementRole="User">
                    <Button Content="&#x2039;" Click="OnPreviousClick"
                            ToolTip.Tip="{loc:Localize Toolbar_Previous}"
                            AutomationProperties.Name="{loc:Localize Toolbar_Previous}" />
                    <Button Content="&#x203A;" Click="OnNextClick"
                            ToolTip.Tip="{loc:Localize Toolbar_Next}"
                            AutomationProperties.Name="{loc:Localize Toolbar_Next}" />
                    <Button Content="{loc:Localize Toolbar_Contents}" Command="{Binding GoToContentsCommand}" />
                    <!-- Bookmarks: mark this page, or turn to a marked one -->
                    <Button x:Name="BookmarksButton"
                            ToolTip.Tip="{loc:Localize Bookmarks_Tip}"
                            AutomationProperties.Name="{loc:Localize Bookmarks_Title}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Bookmark}" />
                            <TextBlock VerticalAlignment="Center" Text="{loc:Localize Bookmarks_Title}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper">
                                <views:BookmarksView DataContext="{Binding Bookmarks}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Notes: write on the reading page, quote its text, export them all -->
                    <Button x:Name="NotesButton"
                            ToolTip.Tip="{loc:Localize Notes_Tip}"
                            AutomationProperties.Name="{loc:Localize Notes_Title}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Note}" />
                            <TextBlock VerticalAlignment="Center" Text="{loc:Localize Notes_Title}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper">
                                <views:NotesView x:Name="NotesPanel" DataContext="{Binding Notes}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Everything the reader can set, in one place -->
                    <Button x:Name="SettingsButton"
                            ToolTip.Tip="{loc:Localize Settings_Tip}"
                            AutomationProperties.Name="{loc:Localize Settings_Title}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Settings}" />
                            <TextBlock VerticalAlignment="Center" Text="{loc:Localize Settings_Title}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper settings">
                                <views:SettingsView DataContext="{Binding Settings}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- A new version (or how the last update went): under the title bar, until installed or put off. -->
        <Border DockPanel.Dock="Top" Classes="updateBanner" IsVisible="{Binding Update.ShowsBanner}">
            <StackPanel Spacing="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                        <Button Classes="bannerPrimary" IsVisible="{Binding !Update.HasNotice}"
                                Command="{Binding Update.InstallOrDownloadCommand}" Content="{Binding Update.PrimaryButtonText}" />
                        <Button Classes="banner" IsVisible="{Binding Update.ReleaseNotes, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Content="{loc:Localize Update_WhatsNew}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper">
                                    <StackPanel>
                                        <TextBlock Classes="kicker" Margin="0,12,0,6" Text="{loc:Localize Update_WhatsNew}" />
                                        <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                                            <SelectableTextBlock Classes="text" FontSize="13" Text="{Binding Update.ReleaseNotes}" />
                                        </ScrollViewer>
                                        <Button Classes="chip" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Command="{Binding Update.OpenReleasePageCommand}" Content="{loc:Localize Update_ReleasePage}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="banner" Command="{Binding Update.DismissCommand}" Content="{loc:Localize Update_Later}" />
                    </StackPanel>
                    <TextBlock Classes="bannerText" IsVisible="{Binding !Update.HasNotice}" Text="{Binding Update.BannerText}" />
                    <TextBlock Classes="bannerText" IsVisible="{Binding Update.HasNotice}" Text="{Binding Update.Notice}" />
                </DockPanel>
                <StackPanel IsVisible="{Binding Update.IsInstalling}" Spacing="4">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Update.Progress}"
                                 IsIndeterminate="{Binding Update.IsProgressIndeterminate}" />
                    <TextBlock Classes="bannerText" FontSize="12" Text="{Binding Update.ProgressText}" />
                </StackPanel>
                <TextBlock Classes="bannerText" FontSize="12" Foreground="#FFE3DA"
                           IsVisible="{Binding Update.HasInstallError}" Text="{Binding Update.InstallError}" />
            </StackPanel>
        </Border>

        <controls:BookView x:Name="Book"
                           Pages="{Binding Pages}"
                           PageIndex="{Binding PageIndex}"
                           AnimatesTurns="{Binding Settings.AnimatesTurns}"
                           BookmarkedPages="{Binding Bookmarks.MarkedPages}" />
    </DockPanel>
</UserControl>
