<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:volcano="using:Lemon.Explore.Book.Chapters.Volcanoes"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Volcanoes.VolcanoDiagramPageView"
                         x:DataType="volcano:VolcanoDiagramPageViewModel">
    <!-- Right page of the Volcanoes spread: the diagram on a dark plate, the walkthrough and the timeline. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <volcano:VolcanoDiagram Mode="{Binding Volcano.Mode}"
                                        IsPlaying="{Binding Volcano.IsPlaying, Mode=TwoWay}"
                                        Progress="{Binding Volcano.Progress, Mode=TwoWay}"
                                        Silica="{Binding Volcano.Silica}"
                                        Water="{Binding Volcano.Water}"
                                        ShowLevels="{Binding Volcano.ShowLevels}"
                                        ShowLabels="{Binding Volcano.ShowLabels}"
                                        JourneyId="{Binding Volcano.JourneyId}"
                                        Process="{Binding Volcano.Process}"
                                        Crystals="{Binding Volcano.Crystals}"
                                        Tank="{Binding Volcano.Tank}"
                                        BurialKm="{Binding Volcano.BurialKm, Mode=TwoWay}"
                                        SqueezeParent="{Binding Volcano.SqueezeParent}"
                                        SqueezeDepthKm="{Binding Volcano.SqueezeDepthKm, Mode=TwoWay}"
                                        ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                        Highlight="{Binding Volcano.Lesson.Highlight}"
                                        IsLessonActive="{Binding Volcano.Lesson.IsActive}"
                                        SelectedObject="{Binding Volcano.Card.Id, Mode=TwoWay}"
                                        InteractionCommand="{Binding Volcano.UserInteractedCommand}"
                                        ToolTip.Tip="{Binding Volcano.Hint}"
                                        AutomationProperties.Name="{Binding Volcano.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Volcano.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Volcano.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Volcano.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Volcano.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Volc_PlayPause}" AutomationProperties.Name="{loc:Localize Volc_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Volcano.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Volcano.IsPlaying}" />
                                </Panel>
                            </Button>
                            <!-- The timeline -->
                            <Slider Width="130" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                    Minimum="0" Maximum="1" Value="{Binding Volcano.Progress}" SmallChange="0.01" LargeChange="0.1" IsVisible="{Binding Volcano.HasTimeline}"
                                    ToolTip.Tip="{loc:Localize Volc_Timeline}" AutomationProperties.Name="{loc:Localize Volc_Timeline}" />
                            <ToggleButton Classes="space" IsChecked="{Binding Volcano.ShowLabels}" Content="{loc:Localize Volc_Option_Labels}"
                                          ToolTip.Tip="{loc:Localize Volc_Option_Labels}" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
