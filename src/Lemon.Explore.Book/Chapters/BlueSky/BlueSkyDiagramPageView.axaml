<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:sky="using:Lemon.Explore.Book.Chapters.BlueSky"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.BlueSky.BlueSkyDiagramPageView"
                         x:DataType="sky:BlueSkyDiagramPageViewModel">
    <!-- Right page of the Blue sky spread: the diagram on a dark plate, the walkthrough and the time of day. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <sky:SkyDiagram Mode="{Binding Sky.Mode}"
                                Hour="{Binding Sky.Hour, Mode=TwoWay}"
                                IsPlaying="{Binding Sky.IsPlaying, Mode=TwoWay}"
                                Haze="{Binding Sky.Haze}"
                                LookAway="{Binding Sky.LookAway}"
                                Latitude="{Binding Sky.Latitude}"
                                Highlight="{Binding Sky.Lesson.Highlight}"
                                IsLessonActive="{Binding Sky.Lesson.IsActive}"
                                SelectedObject="{Binding Sky.Card.Id, Mode=TwoWay}"
                                InteractionCommand="{Binding Sky.UserInteractedCommand}"
                                ToolTip.Tip="{Binding Sky.DragHint}"
                                AutomationProperties.Name="{Binding Sky.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Sky.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Sky.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Sky.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Sky.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Sky_PlayPause}" AutomationProperties.Name="{loc:Localize Sky_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Sky.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Sky.IsPlaying}" />
                                </Panel>
                            </Button>
                            <!-- The time of day -->
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="150" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="{Binding Sky.FirstHour}" Maximum="{Binding Sky.LastHour}" Value="{Binding Sky.Hour}"
                                        SmallChange="0.05" LargeChange="1"
                                        ToolTip.Tip="{loc:Localize Sky_Timeline}" AutomationProperties.Name="{loc:Localize Sky_Timeline}" />
                                <TextBlock MinWidth="140" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource SpaceText}" Text="{Binding Sky.ClockText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
