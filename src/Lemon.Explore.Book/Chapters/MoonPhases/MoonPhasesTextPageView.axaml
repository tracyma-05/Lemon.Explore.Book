<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:moon="using:Lemon.Explore.Book.Chapters.MoonPhases"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.MoonPhases.MoonPhasesTextPageView"
                         x:DataType="moon:MoonPhasesTextPageViewModel">
    <!-- Left page of the Moon phases spread: the Moon from Earth, the options of each view, and tonight's Moon. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Rectangle.legend">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="2.5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(TextBlock).legend">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BodyInkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Moon.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Moon.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Moon.DragHint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="MoonPhasesMode" IsChecked="{Binding Moon.IsPhases}"
                                 Content="{loc:Localize MoonPhases_Mode_Phases}" />
                    <RadioButton Classes="chip" GroupName="MoonPhasesMode" IsChecked="{Binding Moon.IsSky}"
                                 Content="{loc:Localize MoonPhases_Mode_Sky}" />
                    <RadioButton Classes="chip" GroupName="MoonPhasesMode" IsChecked="{Binding Moon.IsMonth}"
                                 Content="{loc:Localize MoonPhases_Mode_Month}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Moon.Card}" />

                <!-- Hemisphere -->
                <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Hemisphere}" />
                <WrapPanel>
                    <RadioButton Classes="chip" GroupName="MoonPhasesHemisphere" IsChecked="{Binding Moon.IsAtHome}"
                                 Content="{Binding Moon.HomeOptionText}" />
                    <RadioButton Classes="chip" GroupName="MoonPhasesHemisphere" IsChecked="{Binding Moon.IsAway}"
                                 Content="{Binding Moon.AwayOptionText}" />
                </WrapPanel>
                <SelectableTextBlock Classes="note" Text="{loc:Localize MoonPhases_Hemisphere_Hint}" />

                <!-- Phases: the Moon seen from Earth, and how much is lit through the month -->
                <StackPanel IsVisible="{Binding Moon.IsPhases}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Disc_Caption}" />
                    <Border Classes="plate" Height="190">
                        <moon:MoonDiscView Age="{Binding Moon.Age}" IsSouthern="{Binding Moon.IsSouthern}"
                                           AutomationProperties.Name="{loc:Localize MoonPhases_Disc_Caption}" />
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                            <Rectangle Classes="legend" Fill="#E0A82E" />
                            <SelectableTextBlock Classes="legend" Text="{loc:Localize MoonPhases_Legend_Lit}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                            <Rectangle Classes="legend" Fill="#5C8FD6" />
                            <SelectableTextBlock Classes="legend" Text="{loc:Localize MoonPhases_Legend_Facing}" />
                        </StackPanel>
                    </WrapPanel>
                    <SelectableTextBlock Classes="note" Text="{loc:Localize MoonPhases_Legend_Note}" />

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Chart_Caption}" />
                    <Border Classes="plate" Height="150">
                        <moon:MoonMonthChart Age="{Binding Moon.Age}" IsSouthern="{Binding Moon.IsSouthern}"
                                             AutomationProperties.Name="{loc:Localize MoonPhases_Chart_Caption}" />
                    </Border>
                </StackPanel>

                <!-- In the sky: the time of day, and where you are on the turning Earth -->
                <StackPanel IsVisible="{Binding Moon.IsSky}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Animate}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="MoonPhasesAnimate" IsChecked="{Binding Moon.AnimatesDay}"
                                     Content="{loc:Localize MoonPhases_Animate_Day}" />
                        <RadioButton Classes="chip" GroupName="MoonPhasesAnimate" IsChecked="{Binding Moon.AnimatesMonth}"
                                     Content="{loc:Localize MoonPhases_Animate_Month}" />
                    </WrapPanel>
                    <DockPanel Margin="0,4,0,0">
                        <SelectableTextBlock DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource BodyInkBrush}" Text="{loc:Localize MoonPhases_TimeOfDay}" />
                        <Slider VerticalAlignment="Center" Minimum="0" Maximum="24" Value="{Binding Moon.TimeOfDay}"
                                SmallChange="0.25" LargeChange="1" AutomationProperties.Name="{loc:Localize MoonPhases_TimeOfDay}" />
                    </DockPanel>
                    <SelectableTextBlock Classes="text" Margin="0,4,0,0" Text="{Binding Moon.SkyNowText}" />

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Observer_Caption}" />
                    <Border Classes="plate" Height="210">
                        <moon:ObserverView Age="{Binding Moon.Age}" TimeOfDay="{Binding Moon.TimeOfDay}"
                                           AutomationProperties.Name="{loc:Localize MoonPhases_Observer_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize MoonPhases_Observer_Note}" />
                </StackPanel>

                <!-- Why 29.5 days -->
                <StackPanel IsVisible="{Binding Moon.IsMonth}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Disc_Caption}" />
                    <Border Classes="plate" Height="170">
                        <moon:MoonDiscView Age="{Binding Moon.Age}" IsSouthern="{Binding Moon.IsSouthern}"
                                           AutomationProperties.Name="{loc:Localize MoonPhases_Disc_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="text" Margin="0,10,0,0" Text="{Binding Moon.MonthText}" />
                </StackPanel>

                <!-- What is happening now: a coloured edge for the phase -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Moon.StageBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkBrush}" Text="{Binding Moon.StageTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Moon.StageDescription}" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <SelectableTextBlock Grid.Row="0" Classes="statName" Text="{loc:Localize MoonPhases_Stat_Age}" />
                                <SelectableTextBlock Grid.Row="0" Classes="statValue" Text="{Binding Moon.AgeText}" />
                                <SelectableTextBlock Grid.Row="1" Classes="statName" Text="{loc:Localize MoonPhases_Stat_Lit}" />
                                <SelectableTextBlock Grid.Row="1" Classes="statValue" Text="{Binding Moon.IlluminationText}" />
                                <SelectableTextBlock Grid.Row="2" Classes="statName" Text="{loc:Localize MoonPhases_Stat_Elongation}" />
                                <SelectableTextBlock Grid.Row="2" Classes="statValue" Text="{Binding Moon.ElongationText}" />
                                <SelectableTextBlock Grid.Row="3" Classes="statName" Text="{loc:Localize MoonPhases_Stat_RiseSet}"
                                           ToolTip.Tip="{loc:Localize MoonPhases_Stat_RiseSet_ToolTip}" />
                                <SelectableTextBlock Grid.Row="3" Classes="statValue" Text="{Binding Moon.RiseSetText}"
                                           ToolTip.Tip="{loc:Localize MoonPhases_Stat_RiseSet_ToolTip}" />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_JumpTo}" />
                <WrapPanel>
                    <Button Classes="chip" Command="{Binding Moon.JumpToCommand}" CommandParameter="New"
                            Content="{loc:Localize MoonPhases_Phase_New}" />
                    <Button Classes="chip" Command="{Binding Moon.JumpToCommand}" CommandParameter="FirstQuarter"
                            Content="{loc:Localize MoonPhases_Phase_FirstQuarter}" />
                    <Button Classes="chip" Command="{Binding Moon.JumpToCommand}" CommandParameter="Full"
                            Content="{loc:Localize MoonPhases_Phase_Full}" />
                    <Button Classes="chip" Command="{Binding Moon.JumpToCommand}" CommandParameter="LastQuarter"
                            Content="{loc:Localize MoonPhases_Phase_LastQuarter}" />
                    <Button Classes="chip" Command="{Binding Moon.JumpToCommand}" CommandParameter="Today"
                            Content="{loc:Localize MoonPhases_Tonight}" />
                </WrapPanel>

                <!-- The real Moon: tonight and the coming phases -->
                <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Upcoming}" />
                <SelectableTextBlock Classes="text" Margin="0,0,0,6" Text="{Binding Moon.TodayText}" />
                <ItemsControl ItemsSource="{Binding Moon.Upcoming}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="moon:UpcomingPhase">
                            <Grid ColumnDefinitions="140,*">
                                <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                <SelectableTextBlock Classes="statValue" Text="{Binding When}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{loc:Localize MoonPhases_Upcoming_Note}" />

                <SelectableTextBlock Classes="caption" Text="{loc:Localize MoonPhases_Facts}" />
                <ItemsControl ItemsSource="{Binding Moon.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="chip" HorizontalAlignment="Left" Command="{Binding Moon.OpenEclipsesCommand}"
                        Content="{loc:Localize MoonPhases_OpenEclipses}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
