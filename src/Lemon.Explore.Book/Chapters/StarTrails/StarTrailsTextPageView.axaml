<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:trails="using:Lemon.Explore.Book.Chapters.StarTrails"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:lessons="using:Lemon.Explore.Book.Explore.Lessons"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.StarTrails.StarTrailsTextPageView"
                         x:DataType="trails:StarTrailsTextPageViewModel">
    <!-- Left page of the Star trails spread: where and when, each view's options and chart, and what is happening. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Trails.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Trails.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Trails.Hint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="TrailsMode" IsChecked="{Binding Trails.IsCamera}" Content="{loc:Localize Trails_Mode_Camera}" />
                    <RadioButton Classes="chip" GroupName="TrailsMode" IsChecked="{Binding Trails.IsSphere}" Content="{loc:Localize Trails_Mode_Sphere}" />
                    <RadioButton Classes="chip" GroupName="TrailsMode" IsChecked="{Binding Trails.IsYear}" Content="{loc:Localize Trails_Mode_Year}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Trails.Card}" />

                <!-- Where: the shared location, or a latitude travelled to -->
                <explore:LocationChip Margin="0,14,0,0" Service="{Binding Trails.Location}" />
                <DockPanel Margin="0,14,0,2">
                    <SelectableTextBlock Classes="value" Text="{Binding Trails.LatitudeText}" />
                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Trails_Latitude}" />
                </DockPanel>
                <Slider Minimum="-90" Maximum="90" Value="{Binding Trails.Latitude}" SmallChange="1" LargeChange="10"
                        IsSnapToTickEnabled="True" TickFrequency="0.1" AutomationProperties.Name="{loc:Localize Trails_Latitude}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Trails.PlaceNote}" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Classes="chip" Command="{Binding Trails.UseMyLatitudeCommand}" Content="{loc:Localize Trails_Go_Home}" />
                    <Button Classes="chip" Command="{Binding Trails.SetLatitudeCommand}" CommandParameter="90" Content="{loc:Localize Trails_Go_NorthPole}" />
                    <Button Classes="chip" Command="{Binding Trails.SetLatitudeCommand}" CommandParameter="0" Content="{loc:Localize Trails_Go_Equator}" />
                    <Button Classes="chip" Command="{Binding Trails.SetLatitudeCommand}" CommandParameter="-90" Content="{loc:Localize Trails_Go_SouthPole}" />
                </WrapPanel>

                <!-- When: the date (the camera's night, the year's evening sky) -->
                <StackPanel IsVisible="{Binding !Trails.IsSphere}">
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Trails.DateText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Trails_DateCaption}" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="365" Value="{Binding Trails.Day}" SmallChange="1" LargeChange="30"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{loc:Localize Trails_DateCaption}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Classes="chip" Command="{Binding Trails.TodayCommand}" Content="{loc:Localize Trails_Today}" />
                        <Button Classes="chip" Command="{Binding Trails.JumpToDayCommand}" CommandParameter="79" Content="{loc:Localize Trails_Day_March}" />
                        <Button Classes="chip" Command="{Binding Trails.JumpToDayCommand}" CommandParameter="172" Content="{loc:Localize Trails_Day_June}" />
                        <Button Classes="chip" Command="{Binding Trails.JumpToDayCommand}" CommandParameter="266" Content="{loc:Localize Trails_Day_September}" />
                        <Button Classes="chip" Command="{Binding Trails.JumpToDayCommand}" CommandParameter="355" Content="{loc:Localize Trails_Day_December}" />
                    </WrapPanel>
                </StackPanel>

                <!-- The camera: which way it points, the shutter, what is drawn -->
                <StackPanel IsVisible="{Binding Trails.IsCamera}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Trails_Face_Caption}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Trails.FaceCommand}" CommandParameter="Pole" Content="{loc:Localize Trails_Face_Pole}" />
                        <Button Classes="chip" Command="{Binding Trails.FaceCommand}" CommandParameter="East" Content="{loc:Localize Trails_Face_East}" />
                        <Button Classes="chip" Command="{Binding Trails.FaceCommand}" CommandParameter="Equator" Content="{loc:Localize Trails_Face_Equator}" />
                        <Button Classes="chip" Command="{Binding Trails.FaceCommand}" CommandParameter="West" Content="{loc:Localize Trails_Face_West}" />
                        <Button Classes="chip" Command="{Binding Trails.FaceCommand}" CommandParameter="Up" Content="{loc:Localize Trails_Face_Up}" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Trails.RestartCommand}" Content="{loc:Localize Trails_Restart}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Trails.ShowFigures}" Content="{loc:Localize Trails_Option_Figures}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Trails.ShowLabels}" Content="{loc:Localize Trails_Option_Labels}" />
                    </WrapPanel>
                </StackPanel>

                <!-- The sphere and the camera: how long each star is up -->
                <StackPanel IsVisible="{Binding !Trails.IsYear}">
                    <WrapPanel Margin="0,6,0,0" IsVisible="{Binding Trails.IsSphere}">
                        <ToggleButton Classes="chip" IsChecked="{Binding Trails.ShowLabels}" Content="{loc:Localize Trails_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Trails_Chart_Hours_Caption}" />
                    <Border Classes="plate" Height="160">
                        <trails:VisibleHoursChart Latitude="{Binding Trails.Latitude}" AutomationProperties.Name="{loc:Localize Trails_Chart_Hours_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Trails_Chart_Hours_Note}" />
                </StackPanel>

                <!-- The year: when constellations stand highest -->
                <StackPanel IsVisible="{Binding Trails.IsYear}">
                    <WrapPanel Margin="0,6,0,0">
                        <ToggleButton Classes="chip" IsChecked="{Binding Trails.ShowLabels}" Content="{loc:Localize Trails_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Trails_Chart_Transit_Caption}" />
                    <Border Classes="plate" Height="180">
                        <trails:TransitChart Day="{Binding Trails.Day}" Latitude="{Binding Trails.Latitude}"
                                             AutomationProperties.Name="{loc:Localize Trails_Chart_Transit_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Trails_Chart_Transit_Note}" />
                </StackPanel>

                <!-- What is happening now: a coloured edge for it -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Trails.PhaseBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Trails.PhaseTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Trails.PhaseDescription}" />
                            <ItemsControl ItemsSource="{Binding Trails.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lessons:OscillationStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Trails_Facts}" />
                <ItemsControl ItemsSource="{Binding Trails.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
