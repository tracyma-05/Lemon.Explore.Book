<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:stars="using:Lemon.Explore.Book.Chapters.StarLife"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.StarLife.StarLifeDiagramPageView"
                         x:DataType="stars:StarLifeDiagramPageViewModel">
    <!-- Right page of the Star life spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <stars:StarDiagram Mode="{Binding Star.Mode}"
                                   Mass="{Binding Star.Mass, Mode=TwoWay}"
                                   Story="{Binding Star.Story, Mode=TwoWay}"
                                   IsPlaying="{Binding Star.IsPlaying, Mode=TwoWay}"
                                   ShowSun="{Binding Star.ShowSun}"
                                   ShowOrbits="{Binding Star.ShowOrbits}"
                                   ShowKnownStars="{Binding Star.ShowKnownStars}"
                                   ShowRadiusLines="{Binding Star.ShowRadiusLines}"
                                   Highlight="{Binding Star.Lesson.Highlight}"
                                   IsLessonActive="{Binding Star.Lesson.IsActive}"
                                   SelectedObject="{Binding Star.Card.Id, Mode=TwoWay}"
                                   InteractionCommand="{Binding Star.UserInteractedCommand}"
                                   ToolTip.Tip="{Binding Star.DragHint}"
                                   AutomationProperties.Name="{Binding Star.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Star.Lesson}" />
                    <Border HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Star.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Star.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Star.StepCommand}" CommandParameter="Previous"
                                    ToolTip.Tip="{loc:Localize Star_PreviousStage}" AutomationProperties.Name="{loc:Localize Star_PreviousStage}">
                                <PathIcon Data="{StaticResource Icon.Previous}" />
                            </Button>
                            <Button Classes="space" Command="{Binding Star.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Star_PlayPause}" AutomationProperties.Name="{loc:Localize Star_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Star.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Star.IsPlaying}" />
                                </Panel>
                            </Button>
                            <Button Classes="space" Command="{Binding Star.StepCommand}" CommandParameter="Next"
                                    ToolTip.Tip="{loc:Localize Star_NextStage}" AutomationProperties.Name="{loc:Localize Star_NextStage}">
                                <PathIcon Data="{StaticResource Icon.Next}" />
                            </Button>
                            <TextBlock MinWidth="130" Margin="8,0,10,0" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource SpaceText}" Text="{Binding Star.ClockText}" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
