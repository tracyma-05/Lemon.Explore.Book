<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:acid="using:Lemon.Explore.Book.Chapters.AcidsBases"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:lessons="using:Lemon.Explore.Book.Explore.Lessons"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.AcidsBases.AcidsBasesTextPageView"
                         x:DataType="acid:AcidsBasesTextPageViewModel">
    <!-- Left page of the Acids and bases spread: the particles, the pH scale or the titration's settings, their charts, and what is happening. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Acids.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Acids.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Acids.Hint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="AcidMode" IsChecked="{Binding Acids.IsParticles}" Content="{loc:Localize Acid_Mode_Particles}" />
                    <RadioButton Classes="chip" GroupName="AcidMode" IsChecked="{Binding Acids.IsScale}" Content="{loc:Localize Acid_Mode_Scale}" />
                    <RadioButton Classes="chip" GroupName="AcidMode" IsChecked="{Binding Acids.IsNeutralize}" Content="{loc:Localize Acid_Mode_Neutralize}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Acids.Card}" />

                <!-- Particles: what goes into the beaker -->
                <StackPanel IsVisible="{Binding Acids.IsParticles}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_Add_Caption}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Acids.AddMlCommand}" CommandParameter="{x:Static acid:Reagent.StrongAcid}" Content="{loc:Localize Acid_Add_StrongAcid}" />
                        <Button Classes="chip" Command="{Binding Acids.AddMlCommand}" CommandParameter="{x:Static acid:Reagent.WeakAcid}" Content="{loc:Localize Acid_Add_WeakAcid}" />
                        <Button Classes="chip" Command="{Binding Acids.AddMlCommand}" CommandParameter="{x:Static acid:Reagent.StrongBase}" Content="{loc:Localize Acid_Add_StrongBase}" />
                        <Button Classes="chip" Command="{Binding Acids.AddMlCommand}" CommandParameter="{x:Static acid:Reagent.WeakBase}" Content="{loc:Localize Acid_Add_WeakBase}" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Acids.DiluteBeakerCommand}" Content="{loc:Localize Acid_Add_Dilute}" />
                        <Button Classes="chip" Command="{Binding Acids.EmptyBeakerCommand}" Content="{loc:Localize Acid_Add_Fresh}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_BeakerIndicator_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AcidBeakerIndicator" IsChecked="{Binding Acids.BeakerIndicatorChoice[None]}" Content="{loc:Localize Acid_Indicator_None}" />
                        <RadioButton Classes="chip" GroupName="AcidBeakerIndicator" IsChecked="{Binding Acids.BeakerIndicatorChoice[Universal]}" Content="{loc:Localize Acid_Indicator_Universal}" />
                        <RadioButton Classes="chip" GroupName="AcidBeakerIndicator" IsChecked="{Binding Acids.BeakerIndicatorChoice[Cabbage]}" Content="{loc:Localize Acid_Indicator_Cabbage}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Acids.ShowParticles}" Content="{loc:Localize Acid_Option_Particles}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Acids.ShowLabels}" Content="{loc:Localize Acid_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Margin="0,2,0,0" Classes="note" Text="{loc:Localize Acid_Particles_Panel_Note}" />
                </StackPanel>

                <!-- Scale: the indicator and watering down -->
                <StackPanel IsVisible="{Binding Acids.IsScale}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_ScaleIndicator_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AcidScaleIndicator" IsChecked="{Binding Acids.ScaleIndicatorChoice[Universal]}" Content="{loc:Localize Acid_Indicator_Universal}" />
                        <RadioButton Classes="chip" GroupName="AcidScaleIndicator" IsChecked="{Binding Acids.ScaleIndicatorChoice[Cabbage]}" Content="{loc:Localize Acid_Indicator_Cabbage}" />
                        <RadioButton Classes="chip" GroupName="AcidScaleIndicator" IsChecked="{Binding Acids.ScaleIndicatorChoice[Litmus]}" Content="{loc:Localize Acid_Indicator_Litmus}" />
                        <RadioButton Classes="chip" GroupName="AcidScaleIndicator" IsChecked="{Binding Acids.ScaleIndicatorChoice[Phenolphthalein]}" Content="{loc:Localize Acid_Indicator_Phenolphthalein}" />
                        <RadioButton Classes="chip" GroupName="AcidScaleIndicator" IsChecked="{Binding Acids.ScaleIndicatorChoice[MethylOrange]}" Content="{loc:Localize Acid_Indicator_MethylOrange}" />
                        <RadioButton Classes="chip" GroupName="AcidScaleIndicator" IsChecked="{Binding Acids.ScaleIndicatorChoice[Bromothymol]}" Content="{loc:Localize Acid_Indicator_Bromothymol}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_Dilute_Caption}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Acids.DiluteCommand}" Content="{loc:Localize Acid_Scale_AddWater}" />
                        <Button Classes="chip" Command="{Binding Acids.UndiluteCommand}" Content="{loc:Localize Acid_Dilute_Undo}" />
                    </WrapPanel>
                    <SelectableTextBlock Margin="0,2,0,0" Classes="note" Text="{loc:Localize Acid_Scale_Panel_Note}" />
                </StackPanel>

                <!-- Neutralise: the acid, the indicator, the base -->
                <StackPanel IsVisible="{Binding Acids.IsNeutralize}">
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Acids.BaseMlText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Acid_BaseAdded}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding Acids.BaseMl}" SmallChange="0.05" LargeChange="1"
                            AutomationProperties.Name="{loc:Localize Acid_BaseAdded}" />
                    <WrapPanel Margin="0,10,0,0">
                        <RadioButton Classes="chip" GroupName="AcidTap" IsChecked="{Binding Acids.TapChoice[Closed]}" Content="{loc:Localize Acid_Tap_Closed}" />
                        <RadioButton Classes="chip" GroupName="AcidTap" IsChecked="{Binding Acids.TapChoice[Drip]}" Content="{loc:Localize Acid_Tap_Drip}" />
                        <RadioButton Classes="chip" GroupName="AcidTap" IsChecked="{Binding Acids.TapChoice[Stream]}" Content="{loc:Localize Acid_Tap_Stream}" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Acids.OneDropCommand}" Content="{loc:Localize Acid_OneDrop}" />
                        <Button Classes="chip" Command="{Binding Acids.RefillCommand}" Content="{loc:Localize Acid_Refill}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_AcidChoice_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AcidAcid" IsChecked="{Binding Acids.AcidChoice[Strong]}" Content="{loc:Localize Acid_Flask_Strong}" />
                        <RadioButton Classes="chip" GroupName="AcidAcid" IsChecked="{Binding Acids.AcidChoice[Weak]}" Content="{loc:Localize Acid_Flask_Weak}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_FlaskIndicator_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AcidFlaskIndicator" IsChecked="{Binding Acids.FlaskIndicatorChoice[Phenolphthalein]}" Content="{loc:Localize Acid_Indicator_Phenolphthalein}" />
                        <RadioButton Classes="chip" GroupName="AcidFlaskIndicator" IsChecked="{Binding Acids.FlaskIndicatorChoice[Bromothymol]}" Content="{loc:Localize Acid_Indicator_Bromothymol}" />
                        <RadioButton Classes="chip" GroupName="AcidFlaskIndicator" IsChecked="{Binding Acids.FlaskIndicatorChoice[MethylOrange]}" Content="{loc:Localize Acid_Indicator_MethylOrange}" />
                        <RadioButton Classes="chip" GroupName="AcidFlaskIndicator" IsChecked="{Binding Acids.FlaskIndicatorChoice[Universal]}" Content="{loc:Localize Acid_Indicator_Universal}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_Molar_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AcidMolar" IsChecked="{Binding Acids.MolarChoice[0.1]}" Content="{loc:Localize Acid_Molar_Dilute}" />
                        <RadioButton Classes="chip" GroupName="AcidMolar" IsChecked="{Binding Acids.MolarChoice[1]}" Content="{loc:Localize Acid_Molar_Strong}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Acids.ShowCompare}" Content="{loc:Localize Acid_Option_Compare}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Acids.ShowParticles}" Content="{loc:Localize Acid_Option_Particles}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Acids.ShowLabels}" Content="{loc:Localize Acid_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Margin="0,2,0,0" Classes="note" Text="{loc:Localize Acid_Neutralize_Panel_Note}" />
                </StackPanel>

                <!-- The view's chart -->
                <SelectableTextBlock Classes="caption" Text="{Binding Acids.ChartCaption}" />
                <Border Classes="plate" Height="190">
                    <acid:AcidBaseChart Mode="{Binding Acids.Mode}"
                                            Beaker="{Binding Acids.Beaker}"
                                            Ph="{Binding Acids.ScalePh}"
                                            ScaleIndicator="{Binding Acids.ScaleIndicator, Mode=TwoWay}"
                                            Acid="{Binding Acids.Acid}"
                                            BaseMl="{Binding Acids.BaseMl}"
                                            Molar="{Binding Acids.Molar}"
                                            InteractionCommand="{Binding Acids.UserInteractedCommand}"
                                            AutomationProperties.Name="{Binding Acids.ChartCaption}" />
                </Border>
                <SelectableTextBlock Margin="0,8,0,0" Classes="note" Text="{Binding Acids.ChartNote}" />


                <!-- What is happening now: a coloured edge for the state -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Acids.PhaseBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Acids.PhaseTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Acids.PhaseDescription}" />
                            <ItemsControl ItemsSource="{Binding Acids.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lessons:OscillationStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Acid_Facts}" />
                <ItemsControl ItemsSource="{Binding Acids.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
