<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:breeze="using:Lemon.Explore.Book.Chapters.SeaBreeze"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:lessons="using:Lemon.Explore.Book.Explore.Lessons"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.SeaBreeze.SeaBreezeTextPageView"
                         x:DataType="breeze:SeaBreezeTextPageViewModel">
    <!-- Left page of the Sea breeze spread: the view's settings, its chart, and what is happening. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Breeze.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Breeze.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Breeze.Hint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="BreezeMode" IsChecked="{Binding Breeze.IsCoast}" Content="{loc:Localize Breeze_Mode_Coast}" />
                    <RadioButton Classes="chip" GroupName="BreezeMode" IsChecked="{Binding Breeze.IsCell}" Content="{loc:Localize Breeze_Mode_Cell}" />
                    <RadioButton Classes="chip" GroupName="BreezeMode" IsChecked="{Binding Breeze.IsMonsoon}" Content="{loc:Localize Breeze_Mode_Monsoon}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Breeze.Card}" />

                <!-- The coast: the weather, what to show, a time to jump to -->
                <StackPanel IsVisible="{Binding Breeze.IsCoast}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Sky_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="BreezeSky" IsChecked="{Binding Breeze.SkyChoice[Clear]}" Content="{loc:Localize Breeze_Sky_Clear}" />
                        <RadioButton Classes="chip" GroupName="BreezeSky" IsChecked="{Binding Breeze.SkyChoice[Overcast]}" Content="{loc:Localize Breeze_Sky_Overcast}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowFlow}" Content="{loc:Localize Breeze_Option_Flow}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowPressure}" Content="{loc:Localize Breeze_Option_Pressure}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowLabels}" Content="{loc:Localize Breeze_Option_Labels}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Jump_Caption}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Breeze.JumpToHourCommand}" CommandParameter="3" Content="{loc:Localize Breeze_Jump_Night}" />
                        <Button Classes="chip" Command="{Binding Breeze.JumpToHourCommand}" CommandParameter="8.5" Content="{loc:Localize Breeze_Jump_Morning}" />
                        <Button Classes="chip" Command="{Binding Breeze.JumpToHourCommand}" CommandParameter="11" Content="{loc:Localize Breeze_Jump_Late_Morning}" />
                        <Button Classes="chip" Command="{Binding Breeze.JumpToHourCommand}" CommandParameter="15" Content="{loc:Localize Breeze_Jump_Afternoon}" />
                        <Button Classes="chip" Command="{Binding Breeze.JumpToHourCommand}" CommandParameter="20.5" Content="{loc:Localize Breeze_Jump_Evening}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Chart_Day_Caption}" />
                    <Border Classes="plate" Height="240">
                        <breeze:DayChart Hour="{Binding Breeze.Hour}" Sky="{Binding Breeze.Sky}" AutomationProperties.Name="{loc:Localize Breeze_Chart_Day_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Breeze_Chart_Day_Note}" />
                </StackPanel>

                <!-- The cell: day or night, the two temperatures -->
                <StackPanel IsVisible="{Binding Breeze.IsCell}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_CellTime_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="BreezeCellTime" IsChecked="{Binding Breeze.CellTimeChoice[Day]}" Content="{loc:Localize Breeze_CellTime_Day}" />
                        <RadioButton Classes="chip" GroupName="BreezeCellTime" IsChecked="{Binding Breeze.CellTimeChoice[Night]}" Content="{loc:Localize Breeze_CellTime_Night}" />
                    </WrapPanel>

                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Breeze.LandTemperatureText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Breeze_LandTemperature}" />
                    </DockPanel>
                    <Slider Minimum="10" Maximum="40" Value="{Binding Breeze.LandTemperature}" SmallChange="1" LargeChange="5"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{loc:Localize Breeze_LandTemperature}" />
                    <DockPanel Margin="0,10,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Breeze.SeaTemperatureText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Breeze_SeaTemperature}" />
                    </DockPanel>
                    <Slider Minimum="10" Maximum="35" Value="{Binding Breeze.SeaTemperature}" SmallChange="1" LargeChange="5"
                            IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="{loc:Localize Breeze_SeaTemperature}" />

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowFlow}" Content="{loc:Localize Breeze_Option_Flow}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowLabels}" Content="{loc:Localize Breeze_Option_Labels}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Chart_Profile_Caption}" />
                    <Border Classes="plate" Height="230">
                        <breeze:PressureProfileChart LandTemperature="{Binding Breeze.LandTemperature}"
                                                     SeaTemperature="{Binding Breeze.SeaTemperature}"
                                                     StepTime="{Binding Breeze.StepTime}"
                                                     AutomationProperties.Name="{loc:Localize Breeze_Chart_Profile_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Breeze_Chart_Profile_Note}" />
                </StackPanel>

                <!-- The monsoon: the city, what to show, a month to jump to -->
                <StackPanel IsVisible="{Binding Breeze.IsMonsoon}">
                    <explore:LocationChip Margin="0,14,0,0" Service="{Binding Breeze.Location}" />
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_City_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="BreezeCity" IsChecked="{Binding Breeze.CityChoice[Changsha]}" Content="{loc:Localize Breeze_City_Changsha}" />
                        <RadioButton Classes="chip" GroupName="BreezeCity" IsChecked="{Binding Breeze.CityChoice[Mumbai]}" Content="{loc:Localize Breeze_City_Mumbai}" />
                        <RadioButton Classes="chip" GroupName="BreezeCity" IsChecked="{Binding Breeze.CityChoice[Guangzhou]}" Content="{loc:Localize Breeze_City_Guangzhou}" />
                        <RadioButton Classes="chip" GroupName="BreezeCity" IsChecked="{Binding Breeze.CityChoice[Shanghai]}" Content="{loc:Localize Breeze_City_Shanghai}" />
                        <RadioButton Classes="chip" GroupName="BreezeCity" IsChecked="{Binding Breeze.CityChoice[Beijing]}" Content="{loc:Localize Breeze_City_Beijing}" />
                        <RadioButton Classes="chip" GroupName="BreezeCity" IsChecked="{Binding Breeze.CityChoice[Darwin]}" Content="{loc:Localize Breeze_City_Darwin}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowFlow}" Content="{loc:Localize Breeze_Option_Winds}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowPressure}" Content="{loc:Localize Breeze_Option_Isobars}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Breeze.ShowLabels}" Content="{loc:Localize Breeze_Option_Labels}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Jump_Caption}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Breeze.JumpToMonthCommand}" CommandParameter="1" Content="{loc:Localize Breeze_Jump_January}" />
                        <Button Classes="chip" Command="{Binding Breeze.JumpToMonthCommand}" CommandParameter="4" Content="{loc:Localize Breeze_Jump_April}" />
                        <Button Classes="chip" Command="{Binding Breeze.JumpToMonthCommand}" CommandParameter="7" Content="{loc:Localize Breeze_Jump_July}" />
                        <Button Classes="chip" Command="{Binding Breeze.JumpToMonthCommand}" CommandParameter="10" Content="{loc:Localize Breeze_Jump_October}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Chart_Rain_Caption}" />
                    <Border Classes="plate" Height="200">
                        <breeze:RainChart City="{Binding Breeze.City}" Month="{Binding Breeze.Month}" AutomationProperties.Name="{loc:Localize Breeze_Chart_Rain_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Breeze_Chart_Rain_Note}" />
                </StackPanel>

                <!-- What is happening now: a coloured edge for the phase -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Breeze.PhaseBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Breeze.PhaseTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Breeze.PhaseDescription}" />
                            <ItemsControl ItemsSource="{Binding Breeze.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lessons:OscillationStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Breeze_Facts}" />
                <ItemsControl ItemsSource="{Binding Breeze.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
