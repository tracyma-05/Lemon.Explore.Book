<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:lightning="using:Lemon.Explore.Book.Chapters.Lightning"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Lightning.LightningDiagramPageView"
                         x:DataType="lightning:LightningDiagramPageViewModel">
    <!-- Right page of the Lightning spread: the diagram on a dark plate, the walkthrough and playback. -->
    <explore:ChapterPageView.Styles>
        <Style Selector="RadioButton.speed">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <lightning:LightningDiagram Mode="{Binding Lightning.Mode}"
                                            Rod="{Binding Lightning.Rod}"
                                            Cloth="{Binding Lightning.Cloth}"
                                            Humidity="{Binding Lightning.Humidity}"
                                            AutoHand="{Binding Lightning.AutoHand, Mode=TwoWay}"
                                            HandScene="{Binding Lightning.HandScene, Mode=TwoWay}"
                                            Charge="{Binding Lightning.Charge, Mode=TwoWay}"
                                            State="{Binding Lightning.State, Mode=OneWayToSource}"
                                            StaticTime="{Binding Lightning.StaticTime, Mode=OneWayToSource}"
                                            CloudTop="{Binding Lightning.CloudTop}"
                                            ShowCharges="{Binding Lightning.ShowCharges}"
                                            MeterX="{Binding Lightning.MeterX, Mode=TwoWay}"
                                            GroundField="{Binding Lightning.GroundField, Mode=OneWayToSource}"
                                            CloudTime="{Binding Lightning.CloudTime, Mode=OneWayToSource}"
                                            LastFlash="{Binding Lightning.LastFlash, Mode=OneWayToSource}"
                                            FlashCount="{Binding Lightning.FlashCount, Mode=OneWayToSource}"
                                            FlashRequest="{Binding Lightning.FlashRequest, Mode=TwoWay}"
                                            Latitude="{Binding Lightning.Latitude}"
                                            PeakCurrent="{Binding Lightning.PeakCurrent}"
                                            LightningRod="{Binding Lightning.LightningRod}"
                                            ShowSphere="{Binding Lightning.ShowSphere}"
                                            Distance="{Binding Lightning.Distance}"
                                            Strokes="{Binding Lightning.Strokes}"
                                            StrikeSeed="{Binding Lightning.StrikeSeed}"
                                            StrikeTime="{Binding Lightning.StrikeTime, Mode=TwoWay}"
                                            ShowLabels="{Binding Lightning.ShowLabels}"
                                            Speed="{Binding Lightning.Speed}"
                                            IsPlaying="{Binding Lightning.IsPlaying, Mode=TwoWay}"
                                            ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                            Highlight="{Binding Lightning.Lesson.Highlight}"
                                            IsLessonActive="{Binding Lightning.Lesson.IsActive}"
                                            SelectedObject="{Binding Lightning.Card.Id, Mode=TwoWay}"
                                            InteractionCommand="{Binding Lightning.UserInteractedCommand}"
                                            ToolTip.Tip="{Binding Lightning.Hint}"
                                            AutomationProperties.Name="{Binding Lightning.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Lightning.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Lightning.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Lightning.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Lightning.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Lightning_PlayPause}" AutomationProperties.Name="{loc:Localize Lightning_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Lightning.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Lightning.IsPlaying}" />
                                </Panel>
                            </Button>
                            <!-- Playback speed -->
                            <StackPanel Margin="2,0" Orientation="Horizontal" ToolTip.Tip="{loc:Localize Lightning_Speed}">
                                <RadioButton Classes="space speed" GroupName="LightningSpeed" Content="¼×" IsChecked="{Binding Lightning.SpeedChoice[0.25]}" />
                                <RadioButton Classes="space speed" GroupName="LightningSpeed" Content="½×" IsChecked="{Binding Lightning.SpeedChoice[0.5]}" />
                                <RadioButton Classes="space speed" GroupName="LightningSpeed" Content="1×" IsChecked="{Binding Lightning.SpeedChoice[1]}" />
                                <RadioButton Classes="space speed" GroupName="LightningSpeed" Content="2×" IsChecked="{Binding Lightning.SpeedChoice[2]}" />
                            </StackPanel>
                            <!-- The strike's timeline -->
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="130" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="{Binding Lightning.StrikeLength}" Value="{Binding Lightning.StrikeTime}" SmallChange="0.1" LargeChange="1"
                                        IsVisible="{Binding Lightning.IsStrike}"
                                        ToolTip.Tip="{loc:Localize Lightning_Timeline}" AutomationProperties.Name="{loc:Localize Lightning_Timeline}" />
                                <TextBlock MinWidth="120" Margin="6,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource SpaceText}" Text="{Binding Lightning.ClockText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
