<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:daynight="using:Lemon.Explore.Book.Chapters.DayNight"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.DayNight.DayNightDiagramPageView"
                         x:DataType="daynight:DayNightDiagramPageViewModel">
    <!-- Right page of the Day and night spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <daynight:DayNightDiagram Mode="{Binding Day.Mode}"
                                          Year="{Binding Day.Year}"
                                          Day="{Binding Day.Day, Mode=TwoWay}"
                                          UtcHours="{Binding Day.UtcHours, Mode=TwoWay}"
                                          IsPlaying="{Binding Day.IsPlaying, Mode=TwoWay}"
                                          AnimatesYear="{Binding Day.AnimatesYear}"
                                          PlaceLatitude="{Binding Day.PlaceLatitude, Mode=TwoWay}"
                                          PlaceLongitude="{Binding Day.PlaceLongitude, Mode=TwoWay}"
                                          PlaceCity="{Binding Day.PlaceCity, Mode=TwoWay}"
                                          ShowTwilight="{Binding Day.ShowTwilight}"
                                          ViewTowardSun="{Binding Day.ViewTowardSun, Mode=TwoWay}"
                                          ViewElevation="{Binding Day.ViewElevation, Mode=TwoWay}"
                                          Highlight="{Binding Day.Lesson.Highlight}"
                                          IsLessonActive="{Binding Day.Lesson.IsActive}"
                                          SelectedObject="{Binding Day.Card.Id, Mode=TwoWay}"
                                          InteractionCommand="{Binding Day.UserInteractedCommand}"
                                          ToolTip.Tip="{Binding Day.DragHint}"
                                          AutomationProperties.Name="{Binding Day.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Day.Lesson}" />
                    <Border HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Day.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Day.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Day.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize DayNight_PlayPause}"
                                    AutomationProperties.Name="{loc:Localize DayNight_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Day.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Day.IsPlaying}" />
                                </Panel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <!-- Timeline: the time of day in UTC. -->
                                <Slider Width="150" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="24" Value="{Binding Day.UtcHours}"
                                        SmallChange="0.25" LargeChange="1"
                                        ToolTip.Tip="{loc:Localize DayNight_Timeline}"
                                        AutomationProperties.Name="{loc:Localize DayNight_Timeline}" />
                                <StackPanel Margin="4,0,8,0" VerticalAlignment="Center" MinWidth="110">
                                    <TextBlock FontSize="13" Foreground="{StaticResource SpaceText}" Text="{Binding Day.PlaceTimeText}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource SpaceTextDim}" Text="{Binding Day.UtcText}" />
                                </StackPanel>
                                <Button Classes="space" Command="{Binding Day.JumpToCommand}" CommandParameter="Now"
                                        Content="{loc:Localize DayNight_Now}"
                                        ToolTip.Tip="{loc:Localize DayNight_Now_ToolTip}"
                                        AutomationProperties.Name="{loc:Localize DayNight_Now_ToolTip}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
