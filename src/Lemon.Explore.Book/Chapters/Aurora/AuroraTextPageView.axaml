<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:aurora="using:Lemon.Explore.Book.Chapters.Aurora"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:lessons="using:Lemon.Explore.Book.Explore.Lessons"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Aurora.AuroraTextPageView"
                         x:DataType="aurora:AuroraTextPageViewModel">
    <!-- Left page of the Aurora spread: the view's settings, its chart, and what is happening. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Aurora.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Aurora.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Aurora.Hint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="AuroraMode" IsChecked="{Binding Aurora.IsShield}" Content="{loc:Localize Aurora_Mode_Shield}" />
                    <RadioButton Classes="chip" GroupName="AuroraMode" IsChecked="{Binding Aurora.IsParticles}" Content="{loc:Localize Aurora_Mode_Particles}" />
                    <RadioButton Classes="chip" GroupName="AuroraMode" IsChecked="{Binding Aurora.IsSky}" Content="{loc:Localize Aurora_Mode_Sky}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Aurora.Card}" />

                <!-- The shield: the solar wind and its magnetic field -->
                <StackPanel IsVisible="{Binding Aurora.IsShield}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Aurora_Wind_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AuroraWind" IsChecked="{Binding Aurora.WindChoice[Calm]}" Content="{loc:Localize Aurora_Wind_Calm}" />
                        <RadioButton Classes="chip" GroupName="AuroraWind" IsChecked="{Binding Aurora.WindChoice[Typical]}" Content="{loc:Localize Aurora_Wind_Typical}" />
                        <RadioButton Classes="chip" GroupName="AuroraWind" IsChecked="{Binding Aurora.WindChoice[Fast]}" Content="{loc:Localize Aurora_Wind_Fast}" />
                        <RadioButton Classes="chip" GroupName="AuroraWind" IsChecked="{Binding Aurora.WindChoice[Storm]}" Content="{loc:Localize Aurora_Wind_Storm}" />
                    </WrapPanel>
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Aurora.WindSpeedText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Aurora_Wind_Speed}" />
                    </DockPanel>
                    <Slider Minimum="250" Maximum="1000" Value="{Binding Aurora.WindSpeed}" SmallChange="10" LargeChange="50"
                            AutomationProperties.Name="{loc:Localize Aurora_Wind_Speed}" />
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Aurora.WindDensityText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Aurora_Wind_Density}" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="40" Value="{Binding Aurora.WindDensity}" SmallChange="0.5" LargeChange="5"
                            AutomationProperties.Name="{loc:Localize Aurora_Wind_Density}" />
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Aurora.BzText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Aurora_Wind_Bz}" />
                    </DockPanel>
                    <Slider Minimum="-25" Maximum="10" Value="{Binding Aurora.Bz}" SmallChange="0.5" LargeChange="5"
                            AutomationProperties.Name="{loc:Localize Aurora_Wind_Bz}" />
                    <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{loc:Localize Aurora_Wind_Note}" />
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Aurora_Options_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Aurora.ShowBelts}" Content="{loc:Localize Aurora_Option_Belts}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Aurora.NoField}" Content="{loc:Localize Aurora_Option_NoField}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Aurora.ShowLabels}" Content="{loc:Localize Aurora_Option_Labels}" />
                    </WrapPanel>
                </StackPanel>

                <!-- A trapped particle: which, how energetic, on which field line -->
                <StackPanel IsVisible="{Binding Aurora.IsParticles}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Aurora_Particle_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AuroraSpecies" IsChecked="{Binding Aurora.SpeciesChoice[Electron]}" Content="{loc:Localize Aurora_Species_Electron}" />
                        <RadioButton Classes="chip" GroupName="AuroraSpecies" IsChecked="{Binding Aurora.SpeciesChoice[Proton]}" Content="{loc:Localize Aurora_Species_Proton}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0" ToolTip.Tip="{loc:Localize Aurora_Energy_Tooltip}">
                        <RadioButton Classes="chip" GroupName="AuroraEnergy" IsChecked="{Binding Aurora.EnergyChoice[1]}" Content="{loc:Localize Aurora_Energy_1keV}" />
                        <RadioButton Classes="chip" GroupName="AuroraEnergy" IsChecked="{Binding Aurora.EnergyChoice[100]}" Content="{loc:Localize Aurora_Energy_100keV}" />
                        <RadioButton Classes="chip" GroupName="AuroraEnergy" IsChecked="{Binding Aurora.EnergyChoice[1000]}" Content="{loc:Localize Aurora_Energy_1MeV}" />
                    </WrapPanel>
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Aurora.ShellText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Aurora_Particle_Shell}" />
                    </DockPanel>
                    <Slider Minimum="2" Maximum="7" Value="{Binding Aurora.Shell}" SmallChange="0.1" LargeChange="0.5"
                            AutomationProperties.Name="{loc:Localize Aurora_Particle_Shell}" />
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Aurora.PitchText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Aurora_Particle_Pitch}" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="89" Value="{Binding Aurora.PitchAngle}" SmallChange="1" LargeChange="5"
                            AutomationProperties.Name="{loc:Localize Aurora_Particle_Pitch}" />
                    <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{loc:Localize Aurora_Particle_Note}" />
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Aurora_Options_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Aurora.ShowRingCurrent}" Content="{loc:Localize Aurora_Option_Ring}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Aurora.ShowBelts}" Content="{loc:Localize Aurora_Option_Belts}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Aurora.ShowLabels}" Content="{loc:Localize Aurora_Option_Labels}" />
                    </WrapPanel>
                </StackPanel>

                <!-- The sky: where you are, how stormy, how energetic, the night -->
                <StackPanel IsVisible="{Binding Aurora.IsSky}">
                    <explore:LocationChip Margin="0,14,0,0" Service="{Binding Aurora.Location}" />
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Aurora_Kp_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="AuroraKp" IsChecked="{Binding Aurora.KpChoice[1]}" Content="{loc:Localize Aurora_KpChip_1}" />
                        <RadioButton Classes="chip" GroupName="AuroraKp" IsChecked="{Binding Aurora.KpChoice[4]}" Content="{loc:Localize Aurora_KpChip_4}" />
                        <RadioButton Classes="chip" GroupName="AuroraKp" IsChecked="{Binding Aurora.KpChoice[6]}" Content="{loc:Localize Aurora_KpChip_6}" />
                        <RadioButton Classes="chip" GroupName="AuroraKp" IsChecked="{Binding Aurora.KpChoice[8]}" Content="{loc:Localize Aurora_KpChip_8}" />
                        <RadioButton Classes="chip" GroupName="AuroraKp" IsChecked="{Binding Aurora.KpChoice[9]}" Content="{loc:Localize Aurora_KpChip_9}" />
                    </WrapPanel>
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Aurora.KpText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Aurora_Kp_Name}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="9" Value="{Binding Aurora.Kp}" SmallChange="0.33" LargeChange="1"
                            AutomationProperties.Name="{loc:Localize Aurora_Kp_Name}" />
                    <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{loc:Localize Aurora_Kp_Note}" />
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Aurora.EnergyText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Aurora_Energy_Name}" />
                    </DockPanel>
                    <Slider Minimum="-0.52" Maximum="1.48" Value="{Binding Aurora.EnergyLog}" SmallChange="0.05" LargeChange="0.25"
                            AutomationProperties.Name="{loc:Localize Aurora_Energy_Name}" />
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Aurora_Night_Caption}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Aurora.NowCommand}" Content="{loc:Localize Aurora_Now}" />
                        <Button Classes="chip" Command="{Binding Aurora.BestHourCommand}" Content="{loc:Localize Aurora_BestHour}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Aurora.ShowLabels}" Content="{loc:Localize Aurora_Option_Labels}" />
                    </WrapPanel>
                </StackPanel>

                <!-- The view's chart -->
                <SelectableTextBlock Classes="caption" Text="{Binding Aurora.ChartCaption}" />
                <Border Classes="plate" Height="180">
                    <aurora:AuroraChart Mode="{Binding Aurora.Mode}" WindSpeed="{Binding Aurora.WindSpeed}" WindDensity="{Binding Aurora.WindDensity}"
                                        Bz="{Binding Aurora.Bz}" Shell="{Binding Aurora.Shell}" PitchAngle="{Binding Aurora.PitchAngle}"
                                        EnergyKeV="{Binding Aurora.EnergyKeV}" AutomationProperties.Name="{Binding Aurora.ChartCaption}" />
                </Border>
                <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{Binding Aurora.ChartNote}" />

                <!-- What is happening now: a coloured edge for the phase -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Aurora.PhaseBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Aurora.PhaseTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Aurora.PhaseDescription}" />
                            <ItemsControl ItemsSource="{Binding Aurora.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lessons:OscillationStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Aurora_Facts}" />
                <ItemsControl ItemsSource="{Binding Aurora.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
