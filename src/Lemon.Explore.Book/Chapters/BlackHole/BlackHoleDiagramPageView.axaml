<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:hole="using:Lemon.Explore.Book.Chapters.BlackHole"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.BlackHole.BlackHoleDiagramPageView"
                         x:DataType="hole:BlackHoleDiagramPageViewModel">
    <!-- Right page of the Black hole spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <hole:BlackHoleDiagram Mode="{Binding Hole.Mode}"
                                       Inclination="{Binding Hole.Inclination, Mode=TwoWay}"
                                       BendLight="{Binding Hole.BendLight}"
                                       ShowDisk="{Binding Hole.ShowDisk}"
                                       Doppler="{Binding Hole.Doppler}"
                                       ShowStars="{Binding Hole.ShowStars}"
                                       StartRadius="{Binding Hole.StartRadius, Mode=TwoWay}"
                                       StartRadialSpeed="{Binding Hole.StartRadialSpeed, Mode=TwoWay}"
                                       StartAngularMomentum="{Binding Hole.StartAngularMomentum, Mode=TwoWay}"
                                       LaunchCount="{Binding Hole.LaunchCount}"
                                       ShowRays="{Binding Hole.ShowRays}"
                                       ShowNewton="{Binding Hole.ShowNewton}"
                                       ProbeRadius="{Binding Hole.ProbeRadius, Mode=TwoWay}"
                                       ProbeTime="{Binding Hole.ProbeTime, Mode=TwoWay}"
                                       FarTime="{Binding Hole.FarTime, Mode=TwoWay}"
                                       ProbeState="{Binding Hole.ProbeState, Mode=TwoWay}"
                                       LensSource="{Binding Hole.LensSource}"
                                       LensX="{Binding Hole.LensX, Mode=TwoWay}"
                                       LensY="{Binding Hole.LensY, Mode=TwoWay}"
                                       EinsteinRadius="{Binding Hole.EinsteinRadius}"
                                       LensOn="{Binding Hole.LensOn}"
                                       ShowRing="{Binding Hole.ShowRing}"
                                       ShowTruePosition="{Binding Hole.ShowTruePosition}"
                                       ShowLabels="{Binding Hole.ShowLabels}"
                                       IsPlaying="{Binding Hole.IsPlaying, Mode=TwoWay}"
                                       ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                       Highlight="{Binding Hole.Lesson.Highlight}"
                                       IsLessonActive="{Binding Hole.Lesson.IsActive}"
                                       SelectedObject="{Binding Hole.Card.Id, Mode=TwoWay}"
                                       InteractionCommand="{Binding Hole.UserInteractedCommand}"
                                       ToolTip.Tip="{Binding Hole.Hint}"
                                       AutomationProperties.Name="{Binding Hole.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Hole.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Hole.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Hole.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Hole.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Hole_PlayPause}" AutomationProperties.Name="{loc:Localize Hole_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Hole.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Hole.IsPlaying}" />
                                </Panel>
                            </Button>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
