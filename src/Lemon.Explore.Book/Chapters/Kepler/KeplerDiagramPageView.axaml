<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:kepler="using:Lemon.Explore.Book.Chapters.Kepler"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Kepler.KeplerDiagramPageView"
                         x:DataType="kepler:KeplerDiagramPageViewModel">
    <!-- Right page of the Kepler spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <kepler:KeplerDiagram Mode="{Binding Kepler.Mode}"
                                      Phase="{Binding Kepler.Phase, Mode=TwoWay}"
                                      Years="{Binding Kepler.Years, Mode=TwoWay}"
                                      StartUtc="{Binding Kepler.StartUtc}"
                                      IsPlaying="{Binding Kepler.IsPlaying, Mode=TwoWay}"
                                      Eccentricity="{Binding Kepler.Eccentricity}"
                                      BodyId="{Binding Kepler.Body.Selected}"
                                      Sectors="{Binding Kepler.Sectors}"
                                      ShowString="{Binding Kepler.ShowString}"
                                      ShowCircle="{Binding Kepler.ShowCircle}"
                                      ShowVelocity="{Binding Kepler.ShowVelocity}"
                                      YourAxis="{Binding Kepler.YourAxis, Mode=TwoWay}"
                                      Highlight="{Binding Kepler.Lesson.Highlight}"
                                      IsLessonActive="{Binding Kepler.Lesson.IsActive}"
                                      SelectedObject="{Binding Kepler.Card.Id, Mode=TwoWay}"
                                      InteractionCommand="{Binding Kepler.UserInteractedCommand}"
                                      ToolTip.Tip="{Binding Kepler.DragHint}"
                                      AutomationProperties.Name="{Binding Kepler.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Kepler.Lesson}" />
                    <Border HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Kepler.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Kepler.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Kepler.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Kepler_PlayPause}"
                                    AutomationProperties.Name="{loc:Localize Kepler_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Kepler.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Kepler.IsPlaying}" />
                                </Panel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <!-- Timeline: one round of the orbit, or years ahead in the periods view. -->
                                <Slider Width="150" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="1" Value="{Binding Kepler.Phase}"
                                        SmallChange="0.005" LargeChange="0.05"
                                        IsVisible="{Binding Kepler.IsOrbitMode}"
                                        ToolTip.Tip="{loc:Localize Kepler_Timeline_Orbit}"
                                        AutomationProperties.Name="{loc:Localize Kepler_Timeline_Orbit}" />
                                <Slider Width="150" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="{Binding Kepler.MaxYears}" Value="{Binding Kepler.Years}"
                                        SmallChange="0.1" LargeChange="1"
                                        IsVisible="{Binding Kepler.IsPeriods}"
                                        ToolTip.Tip="{loc:Localize Kepler_Timeline_Years}"
                                        AutomationProperties.Name="{loc:Localize Kepler_Timeline_Years}" />
                                <TextBlock MinWidth="110" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource SpaceText}" Text="{Binding Kepler.ClockText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
