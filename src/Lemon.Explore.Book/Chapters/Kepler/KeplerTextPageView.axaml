<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:kepler="using:Lemon.Explore.Book.Chapters.Kepler"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Kepler.KeplerTextPageView"
                         x:DataType="kepler:KeplerTextPageViewModel">
    <!-- Left page of the Kepler spread: the orbit's settings, each view's own pictures and the planets' periods. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).cell">
            <Setter Property="Margin" Value="0,3,10,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).head">
            <Setter Property="Margin" Value="0,0,10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Kepler.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Kepler.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Kepler.DragHint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="KeplerMode" IsChecked="{Binding Kepler.IsEllipse}"
                                 Content="{loc:Localize Kepler_Mode_Ellipse}" />
                    <RadioButton Classes="chip" GroupName="KeplerMode" IsChecked="{Binding Kepler.IsAreas}"
                                 Content="{loc:Localize Kepler_Mode_Areas}" />
                    <RadioButton Classes="chip" GroupName="KeplerMode" IsChecked="{Binding Kepler.IsPeriods}"
                                 Content="{loc:Localize Kepler_Mode_Periods}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Kepler.Card}" />

                <!-- Ellipse and areas: which body, and the shape of its orbit -->
                <StackPanel IsVisible="{Binding Kepler.IsOrbitMode}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_Body_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="KeplerBody" IsChecked="{Binding Kepler.Body[Custom]}"
                                     Content="{loc:Localize Kepler_Body_Custom}" />
                        <RadioButton Classes="chip" GroupName="KeplerBody" IsChecked="{Binding Kepler.Body[Earth]}"
                                     Content="{loc:Localize SolarSystem_Earth_Name}" />
                        <RadioButton Classes="chip" GroupName="KeplerBody" IsChecked="{Binding Kepler.Body[Mars]}"
                                     Content="{loc:Localize SolarSystem_Mars_Name}" />
                        <RadioButton Classes="chip" GroupName="KeplerBody" IsChecked="{Binding Kepler.Body[Mercury]}"
                                     Content="{loc:Localize SolarSystem_Mercury_Name}" />
                        <RadioButton Classes="chip" GroupName="KeplerBody" IsChecked="{Binding Kepler.Body[Pluto]}"
                                     Content="{loc:Localize Kepler_Body_Pluto}" />
                        <RadioButton Classes="chip" GroupName="KeplerBody" IsChecked="{Binding Kepler.Body[Halley]}"
                                     Content="{loc:Localize Kepler_Body_Halley}" />
                    </WrapPanel>
                    <DockPanel Margin="0,8,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Kepler.EccentricityText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Kepler_Ecc_Slider}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="{Binding Kepler.MaxEccentricity}" Value="{Binding Kepler.Eccentricity}"
                            SmallChange="0.01" LargeChange="0.1" AutomationProperties.Name="{loc:Localize Kepler_Ecc_Slider}" />
                </StackPanel>

                <!-- Ellipse: the string, a circle to compare, and what the eccentricity measures -->
                <StackPanel IsVisible="{Binding Kepler.IsEllipse}">
                    <WrapPanel Margin="0,8,0,0">
                        <ToggleButton Classes="chip" IsChecked="{Binding Kepler.ShowString}" Content="{loc:Localize Kepler_ShowString}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Kepler.ShowCircle}" Content="{loc:Localize Kepler_ShowCircle}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_Ecc_Caption}" />
                    <Border Classes="plate" Height="230">
                        <kepler:EccentricityView Eccentricity="{Binding Kepler.Eccentricity}"
                                                 AutomationProperties.Name="{loc:Localize Kepler_Ecc_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Kepler_Ecc_Note}" />
                </StackPanel>

                <!-- Areas: how many stretches, the velocity arrow, and the speed through one round -->
                <StackPanel IsVisible="{Binding Kepler.IsAreas}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_Sectors_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="KeplerSectors" IsChecked="{Binding Kepler.SectorChoice[6]}" Content="6" />
                        <RadioButton Classes="chip" GroupName="KeplerSectors" IsChecked="{Binding Kepler.SectorChoice[8]}" Content="8" />
                        <RadioButton Classes="chip" GroupName="KeplerSectors" IsChecked="{Binding Kepler.SectorChoice[12]}" Content="12" />
                        <RadioButton Classes="chip" GroupName="KeplerSectors" IsChecked="{Binding Kepler.SectorChoice[24]}" Content="24" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Kepler.ShowVelocity}" Content="{loc:Localize Kepler_ShowVelocity}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_Speed_Caption}" />
                    <Border Classes="plate" Height="170">
                        <kepler:SpeedChart Phase="{Binding Kepler.Phase}" Eccentricity="{Binding Kepler.Eccentricity}"
                                           SemiMajorAxis="{Binding Kepler.SemiMajorAxis}"
                                           AutomationProperties.Name="{loc:Localize Kepler_Speed_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Kepler_Speed_Note}" />
                </StackPanel>

                <!-- Periods: your planet's distance, the law on a chart, and the measured planets -->
                <StackPanel IsVisible="{Binding Kepler.IsPeriods}">
                    <DockPanel Margin="0,16,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Kepler.YourAxisText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Kepler_YourAxis_Caption}" />
                    </DockPanel>
                    <Slider Minimum="{Binding Kepler.MinYourAxis}" Maximum="{Binding Kepler.MaxYourAxis}" Value="{Binding Kepler.YourAxis}"
                            SmallChange="0.05" LargeChange="0.5" AutomationProperties.Name="{loc:Localize Kepler_YourAxis_Caption}" />
                    <SelectableTextBlock Classes="note" Margin="0,4,0,6" Text="{loc:Localize Kepler_YourAxis_Like}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Kepler.SetYourAxisCommand}" CommandParameter="0.387"
                                Content="{loc:Localize SolarSystem_Mercury_Name}" />
                        <Button Classes="chip" Command="{Binding Kepler.SetYourAxisCommand}" CommandParameter="1"
                                Content="{loc:Localize SolarSystem_Earth_Name}" />
                        <Button Classes="chip" Command="{Binding Kepler.SetYourAxisCommand}" CommandParameter="1.524"
                                Content="{loc:Localize SolarSystem_Mars_Name}" />
                        <Button Classes="chip" Command="{Binding Kepler.SetYourAxisCommand}" CommandParameter="2.766"
                                Content="{loc:Localize Kepler_Body_Ceres}" />
                        <Button Classes="chip" Command="{Binding Kepler.SetYourAxisCommand}" CommandParameter="5.203"
                                Content="{loc:Localize SolarSystem_Jupiter_Name}" />
                        <Button Classes="chip" Command="{Binding Kepler.SetYourAxisCommand}" CommandParameter="9.537"
                                Content="{loc:Localize SolarSystem_Saturn_Name}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_PeriodChart_Caption}" />
                    <Border Classes="plate" Height="240">
                        <kepler:PeriodChart YourAxis="{Binding Kepler.YourAxis}"
                                            AutomationProperties.Name="{loc:Localize Kepler_PeriodChart_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Kepler_PeriodChart_Note}" />

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_Table_Caption}" />
                    <Grid ColumnDefinitions="90,90,90,*">
                        <SelectableTextBlock Classes="head" Text="{loc:Localize Kepler_Table_Body}" />
                        <SelectableTextBlock Grid.Column="1" Classes="head" Text="{loc:Localize Kepler_Table_A}" />
                        <SelectableTextBlock Grid.Column="2" Classes="head" Text="{loc:Localize Kepler_Table_T}" />
                        <SelectableTextBlock Grid.Column="3" Classes="head" Text="{loc:Localize Kepler_Table_Ratio}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Kepler.PeriodRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="kepler:KeplerPeriodRow">
                                <Grid ColumnDefinitions="90,90,90,*">
                                    <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                    <SelectableTextBlock Grid.Column="1" Classes="cell" Text="{Binding Distance}" />
                                    <SelectableTextBlock Grid.Column="2" Classes="cell" Text="{Binding Period}" />
                                    <SelectableTextBlock Grid.Column="3" Classes="cell" Foreground="{DynamicResource AccentBrush}" Text="{Binding Ratio}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- What is happening now: a coloured edge for the stage of the orbit -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Kepler.StageBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkBrush}" Text="{Binding Kepler.StageTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Kepler.StageDescription}" />
                            <ItemsControl ItemsSource="{Binding Kepler.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kepler:KeplerStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_JumpTo}" />
                <WrapPanel>
                    <Button Classes="chip" Command="{Binding Kepler.JumpToCommand}" CommandParameter="Perihelion"
                            IsVisible="{Binding Kepler.IsOrbitMode}" Content="{loc:Localize Kepler_Jump_Perihelion}" />
                    <Button Classes="chip" Command="{Binding Kepler.JumpToCommand}" CommandParameter="Aphelion"
                            IsVisible="{Binding Kepler.IsOrbitMode}" Content="{loc:Localize Kepler_Jump_Aphelion}" />
                    <Button Classes="chip" Command="{Binding Kepler.JumpToCommand}" CommandParameter="Today"
                            IsVisible="{Binding Kepler.IsPeriods}" Content="{loc:Localize Kepler_Jump_Today}" />
                </WrapPanel>

                <!-- Earth's own perihelion and aphelion -->
                <StackPanel IsVisible="{Binding Kepler.IsOrbitMode}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_Earth_Caption}" />
                    <ItemsControl ItemsSource="{Binding Kepler.EarthApsides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="kepler:KeplerStat">
                                <Grid ColumnDefinitions="130,*">
                                    <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                    <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{loc:Localize Kepler_Earth_Note}" />
                </StackPanel>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Kepler_Facts}" />
                <ItemsControl ItemsSource="{Binding Kepler.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="chip" HorizontalAlignment="Left" Command="{Binding Kepler.OpenSolarSystemCommand}"
                        Content="{loc:Localize Kepler_OpenSolarSystem}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
