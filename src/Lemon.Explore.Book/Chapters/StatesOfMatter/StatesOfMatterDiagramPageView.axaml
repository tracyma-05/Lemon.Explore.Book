<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:matter="using:Lemon.Explore.Book.Chapters.StatesOfMatter"
                         xmlns:explore="using:Lemon.Book.Shell.Controls.Explore"
                         xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.StatesOfMatter.StatesOfMatterDiagramPageView"
                         x:DataType="matter:StatesOfMatterDiagramPageViewModel">
    <!-- Right page of the States of matter spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <matter:MatterDiagram Mode="{Binding Matter.Mode}"
                                      Substance="{Binding Matter.Substance}"
                                      Celsius="{Binding Matter.Celsius, Mode=TwoWay}"
                                      PressureLog="{Binding Matter.PressureLog, Mode=TwoWay}"
                                      Place="{Binding Matter.Place, Mode=TwoWay}"
                                      Heat="{Binding Matter.Heat, Mode=TwoWay}"
                                      HeatKj="{Binding Matter.HeatKj, Mode=TwoWay}"
                                      ShowBonds="{Binding Matter.ShowBonds}"
                                      ShowLabels="{Binding Matter.ShowLabels}"
                                      ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                      Highlight="{Binding Matter.Lesson.Highlight}"
                                      IsLessonActive="{Binding Matter.Lesson.IsActive}"
                                      SelectedObject="{Binding Matter.Card.Id, Mode=TwoWay}"
                                      InteractionCommand="{Binding Matter.UserInteractedCommand}"
                                      ToolTip.Tip="{Binding Matter.Hint}"
                                      AutomationProperties.Name="{Binding Matter.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Matter.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Matter.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Matter.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="space" IsChecked="{Binding Matter.ShowLabels}" Content="{loc:Localize Matter_Option_Labels}" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
