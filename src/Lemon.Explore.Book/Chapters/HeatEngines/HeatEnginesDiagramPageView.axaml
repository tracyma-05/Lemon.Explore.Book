<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:heat="using:Lemon.Explore.Book.Chapters.HeatEngines"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.HeatEngines.HeatEnginesDiagramPageView"
                         x:DataType="heat:HeatEnginesDiagramPageViewModel">
    <!-- Right page of the Heat engines spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <heat:HeatDiagram Mode="{Binding Heat.Mode}"
                                  Angle="{Binding Heat.Angle, Mode=TwoWay}"
                                  CompressionRatio="{Binding Heat.CompressionRatio}"
                                  Ambient="{Binding Heat.Ambient}"
                                  Room="{Binding Heat.Room}"
                                  DoorOpen="{Binding Heat.DoorOpen, Mode=TwoWay}"
                                  Phase="{Binding Heat.Phase, Mode=TwoWay}"
                                  Hot="{Binding Heat.Hot}"
                                  Cold="{Binding Heat.Cold}"
                                  Direction="{Binding Heat.Direction}"
                                  ShowLabels="{Binding Heat.ShowLabels}"
                                  Speed="{Binding Heat.Speed}"
                                  IsPlaying="{Binding Heat.IsPlaying, Mode=TwoWay}"
                                  ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                  Highlight="{Binding Heat.Lesson.Highlight}"
                                  IsLessonActive="{Binding Heat.Lesson.IsActive}"
                                  SelectedObject="{Binding Heat.Card.Id, Mode=TwoWay}"
                                  InteractionCommand="{Binding Heat.UserInteractedCommand}"
                                  ToolTip.Tip="{Binding Heat.Hint}"
                                  AutomationProperties.Name="{Binding Heat.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Heat.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Heat.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Heat.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Heat.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Heat_PlayPause}" AutomationProperties.Name="{loc:Localize Heat_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Heat.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Heat.IsPlaying}" />
                                </Panel>
                            </Button>
                            <!-- Playback speed -->
                            <StackPanel Margin="2,0" Orientation="Horizontal" ToolTip.Tip="{loc:Localize Heat_Speed}">
                                <RadioButton Classes="space speed" GroupName="HeatSpeed" Content="{loc:Localize Heat_Speed_Quarter}" IsChecked="{Binding Heat.SpeedChoice[0.25]}" />
                                <RadioButton Classes="space speed" GroupName="HeatSpeed" Content="{loc:Localize Heat_Speed_Half}" IsChecked="{Binding Heat.SpeedChoice[0.5]}" />
                                <RadioButton Classes="space speed" GroupName="HeatSpeed" Content="{loc:Localize Heat_Speed_One}" IsChecked="{Binding Heat.SpeedChoice[1]}" />
                                <RadioButton Classes="space speed" GroupName="HeatSpeed" Content="{loc:Localize Heat_Speed_Two}" IsChecked="{Binding Heat.SpeedChoice[2]}" />
                            </StackPanel>
                            <!-- The timeline of the view: the crank's two turns, the cycle's four steps -->
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="130" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="720" Value="{Binding Heat.Angle}" SmallChange="5" LargeChange="45"
                                        IsVisible="{Binding Heat.IsEngine}"
                                        ToolTip.Tip="{loc:Localize Heat_Timeline_Engine}" AutomationProperties.Name="{loc:Localize Heat_Timeline_Engine}" />
                                <Slider Width="130" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="4" Value="{Binding Heat.Phase}" SmallChange="0.05" LargeChange="0.5"
                                        IsVisible="{Binding Heat.IsCycle}"
                                        ToolTip.Tip="{loc:Localize Heat_Timeline_Cycle}" AutomationProperties.Name="{loc:Localize Heat_Timeline_Cycle}" />
                                <TextBlock MinWidth="110" Margin="6,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource SpaceText}" Text="{Binding Heat.ClockText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
