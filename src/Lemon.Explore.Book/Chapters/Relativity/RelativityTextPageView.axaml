<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:rel="using:Lemon.Explore.Book.Chapters.Relativity"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:lessons="using:Lemon.Explore.Book.Explore.Lessons"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Relativity.RelativityTextPageView"
                         x:DataType="rel:RelativityTextPageViewModel">
    <!-- Left page of the Relativity spread: the light clock, the train or the twins' settings, their charts, and what is happening. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Relativity.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Relativity.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Relativity.Hint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="RelMode" IsChecked="{Binding Relativity.IsLightClock}" Content="{loc:Localize Rel_Mode_LightClock}" />
                    <RadioButton Classes="chip" GroupName="RelMode" IsChecked="{Binding Relativity.IsSimultaneity}" Content="{loc:Localize Rel_Mode_Simultaneity}" />
                    <RadioButton Classes="chip" GroupName="RelMode" IsChecked="{Binding Relativity.IsTwins}" Content="{loc:Localize Rel_Mode_Twins}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Relativity.Card}" />

                <!-- The speed, shared by every view -->
                <DockPanel Margin="0,14,0,2">
                    <SelectableTextBlock Classes="value" Text="{Binding Relativity.BetaText}" />
                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Rel_Speed}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="0.99" Value="{Binding Relativity.Beta}" SmallChange="0.01" LargeChange="0.1"
                        AutomationProperties.Name="{loc:Localize Rel_Speed}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Classes="chip" Command="{Binding Relativity.SetSpeedCommand}" CommandParameter="0.1" Content="{loc:Localize Rel_Speed_Tenth}" />
                    <Button Classes="chip" Command="{Binding Relativity.SetSpeedCommand}" CommandParameter="0.6" Content="{loc:Localize Rel_Speed_Six}" />
                    <Button Classes="chip" Command="{Binding Relativity.SetSpeedCommand}" CommandParameter="0.8" Content="{loc:Localize Rel_Speed_Eight}" />
                    <Button Classes="chip" Command="{Binding Relativity.SetSpeedCommand}" CommandParameter="0.99" Content="{loc:Localize Rel_Speed_Near}" />
                </WrapPanel>

                <!-- Whose point of view -->
                <StackPanel IsVisible="{Binding Relativity.HasFrame}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Rel_Frame_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="RelativityFrame" IsChecked="{Binding Relativity.FrameChoice[Ground]}" Content="{Binding Relativity.GroundFrameText}" />
                        <RadioButton Classes="chip" GroupName="RelativityFrame" IsChecked="{Binding Relativity.FrameChoice[Ship]}" Content="{Binding Relativity.ShipFrameText}" />
                    </WrapPanel>
                </StackPanel>

                <!-- Light clock: what is drawn -->
                <StackPanel IsVisible="{Binding Relativity.IsLightClock}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Rel_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowTrail}" Content="{loc:Localize Rel_Option_Trail}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowTriangle}" Content="{loc:Localize Rel_Option_Triangle}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowLabels}" Content="{loc:Localize Rel_Option_Labels}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Classes="chip" Command="{Binding Relativity.ResetClocksCommand}" Content="{loc:Localize Rel_ResetClocks}" />
                    </WrapPanel>
                    <SelectableTextBlock Margin="0,2,0,0" Classes="note" Text="{loc:Localize Rel_LightClock_Panel_Note}" />
                </StackPanel>

                <!-- The train: what is drawn -->
                <StackPanel IsVisible="{Binding Relativity.IsSimultaneity}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Rel_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowLengths}" Content="{loc:Localize Rel_Option_Lengths}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowClocks}" Content="{loc:Localize Rel_Option_Clocks}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowLabels}" Content="{loc:Localize Rel_Option_Labels}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Classes="chip" Command="{Binding Relativity.FlashAgainCommand}" Content="{loc:Localize Rel_FlashAgain}" />
                    </WrapPanel>
                    <SelectableTextBlock Margin="0,2,0,0" Classes="note" Text="{loc:Localize Rel_Simultaneity_Panel_Note}" />
                </StackPanel>

                <!-- The twins: the star and what is drawn -->
                <StackPanel IsVisible="{Binding Relativity.IsTwins}">
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Relativity.DistanceText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Rel_Distance}" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="10" Value="{Binding Relativity.Distance}" SmallChange="0.1" LargeChange="1"
                            AutomationProperties.Name="{loc:Localize Rel_Distance}" />

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Rel_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowSignals}" Content="{loc:Localize Rel_Option_Signals}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowNowLines}" Content="{loc:Localize Rel_Option_NowLines}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowAxes}" Content="{loc:Localize Rel_Option_Axes}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Relativity.ShowLabels}" Content="{loc:Localize Rel_Option_Labels}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Classes="chip" Command="{Binding Relativity.RestartTripCommand}" Content="{loc:Localize Rel_RestartTrip}" />
                    </WrapPanel>
                    <SelectableTextBlock Margin="0,2,0,0" Classes="note" Text="{loc:Localize Rel_Twins_Panel_Note}" />
                </StackPanel>

                <!-- The view's chart -->
                <SelectableTextBlock Classes="caption" Text="{Binding Relativity.ChartCaption}" />
                <Border Classes="plate" Height="190">
                    <rel:RelativityChart Mode="{Binding Relativity.Mode}"
                                                Beta="{Binding Relativity.Beta, Mode=TwoWay}"
                                                Distance="{Binding Relativity.Distance}"
                                                TwinTime="{Binding Relativity.TwinTime, Mode=TwoWay}"
                                                IsPlaying="{Binding Relativity.IsPlaying, Mode=TwoWay}"
                                                InteractionCommand="{Binding Relativity.UserInteractedCommand}"
                                                AutomationProperties.Name="{Binding Relativity.ChartCaption}" />
                </Border>
                <SelectableTextBlock Margin="0,8,0,0" Classes="note" Text="{Binding Relativity.ChartNote}" />


                <!-- What is happening now: a coloured edge for the state -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Relativity.PhaseBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Relativity.PhaseTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Relativity.PhaseDescription}" />
                            <ItemsControl ItemsSource="{Binding Relativity.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lessons:OscillationStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Rel_Facts}" />
                <ItemsControl ItemsSource="{Binding Relativity.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
