<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:flight="using:Lemon.Explore.Book.Chapters.Flight"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Flight.FlightDiagramPageView"
                         x:DataType="flight:FlightDiagramPageViewModel">
    <!-- Right page of the Flight spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <flight:FlightDiagram Mode="{Binding Flight.Mode}"
                                      Shape="{Binding Flight.Shape}"
                                      Inverted="{Binding Flight.Inverted}"
                                      Alpha="{Binding Flight.Alpha, Mode=TwoWay}"
                                      AirSpeed="{Binding Flight.AirSpeed}"
                                      ShowPressure="{Binding Flight.ShowPressure}"
                                      ShowStreamlines="{Binding Flight.ShowStreamlines}"
                                      ShowSmoke="{Binding Flight.ShowSmoke}"
                                      ShowTimelines="{Binding Flight.ShowTimelines}"
                                      ShowArrows="{Binding Flight.ShowArrows}"
                                      Throttle="{Binding Flight.Throttle, Mode=TwoWay}"
                                      PlaneAlpha="{Binding Flight.PlaneAlpha, Mode=TwoWay}"
                                      Mass="{Binding Flight.Mass}"
                                      Speed="{Binding Flight.Speed, Mode=TwoWay}"
                                      Altitude="{Binding Flight.Altitude, Mode=TwoWay}"
                                      PathAngle="{Binding Flight.PathAngle, Mode=TwoWay}"
                                      OnGround="{Binding Flight.OnGround, Mode=TwoWay}"
                                      PositionX="{Binding Flight.PositionX, Mode=TwoWay}"
                                      Bank="{Binding Flight.Bank, Mode=TwoWay}"
                                      TurnSpeed="{Binding Flight.TurnSpeed}"
                                      Demo="{Binding Flight.Demo, Mode=TwoWay}"
                                      ShowLabels="{Binding Flight.ShowLabels}"
                                      IsPlaying="{Binding Flight.IsPlaying, Mode=TwoWay}"
                                      ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                      Highlight="{Binding Flight.Lesson.Highlight}"
                                      IsLessonActive="{Binding Flight.Lesson.IsActive}"
                                      SelectedObject="{Binding Flight.Card.Id, Mode=TwoWay}"
                                      InteractionCommand="{Binding Flight.UserInteractedCommand}"
                                      ToolTip.Tip="{Binding Flight.Hint}"
                                      AutomationProperties.Name="{Binding Flight.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Flight.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Flight.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Flight.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Flight.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Flight_PlayPause}" AutomationProperties.Name="{loc:Localize Flight_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Flight.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Flight.IsPlaying}" />
                                </Panel>
                            </Button>
                            <ToggleButton Classes="space" IsChecked="{Binding Flight.ShowLabels}" Content="{loc:Localize Flight_Option_Labels}" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
