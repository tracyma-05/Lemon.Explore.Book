<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:flight="using:Lemon.Explore.Book.Chapters.Flight"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:lessons="using:Lemon.Explore.Book.Explore.Lessons"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Flight.FlightTextPageView"
                         x:DataType="flight:FlightTextPageViewModel">
    <!-- Left page of the Flight spread: the wing, the plane's controls or the turn, its chart, and what is happening. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Flight.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Flight.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Flight.Hint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="FlightMode" IsChecked="{Binding Flight.IsWing}" Content="{loc:Localize Flight_Mode_Wing}" />
                    <RadioButton Classes="chip" GroupName="FlightMode" IsChecked="{Binding Flight.IsForces}" Content="{loc:Localize Flight_Mode_Forces}" />
                    <RadioButton Classes="chip" GroupName="FlightMode" IsChecked="{Binding Flight.IsTurn}" Content="{loc:Localize Flight_Mode_Turn}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Flight.Card}" />

                <!-- Wing: its shape, angle and the tunnel's speed, and what to show -->
                <StackPanel IsVisible="{Binding Flight.IsWing}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Shape_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="FlightShape" IsChecked="{Binding Flight.ShapeChoice[Cambered]}" Content="{loc:Localize Flight_Shape_Cambered}" />
                        <RadioButton Classes="chip" GroupName="FlightShape" IsChecked="{Binding Flight.ShapeChoice[Symmetric]}" Content="{loc:Localize Flight_Shape_Symmetric}" />
                        <RadioButton Classes="chip" GroupName="FlightShape" IsChecked="{Binding Flight.ShapeChoice[Flat]}" Content="{loc:Localize Flight_Shape_Flat}" />
                        <RadioButton Classes="chip" GroupName="FlightShape" IsChecked="{Binding Flight.ShapeChoice[Bird]}" Content="{loc:Localize Flight_Shape_Bird}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.Inverted}" Content="{loc:Localize Flight_Option_Inverted}" />
                    </WrapPanel>
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Flight.AlphaText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Flight_Alpha}" />
                    </DockPanel>
                    <Slider Minimum="-10" Maximum="25" Value="{Binding Flight.Alpha}" SmallChange="0.5" LargeChange="2"
                            IsSnapToTickEnabled="True" TickFrequency="0.5"
                            AutomationProperties.Name="{loc:Localize Flight_Alpha}" />
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Flight.AirSpeedText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Flight_AirSpeed}" />
                    </DockPanel>
                    <Slider Minimum="50" Maximum="300" Value="{Binding Flight.AirSpeed}" SmallChange="10" LargeChange="50"
                            IsSnapToTickEnabled="True" TickFrequency="10"
                            AutomationProperties.Name="{loc:Localize Flight_AirSpeed}" />
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowPressure}" Content="{loc:Localize Flight_Option_Pressure}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowStreamlines}" Content="{loc:Localize Flight_Option_Streamlines}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowSmoke}" Content="{loc:Localize Flight_Option_Smoke}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowTimelines}" Content="{loc:Localize Flight_Option_Timelines}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowArrows}" Content="{loc:Localize Flight_Option_Arrows}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowLabels}" Content="{loc:Localize Flight_Option_Labels}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Classes="chip" Command="{Binding Flight.EqualTransitCommand}" Content="{loc:Localize Flight_EqualTransit}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Flight_Wing_Panel_Note}" />
                </StackPanel>

                <!-- Forces: flights to start from, the controls and the load -->
                <StackPanel IsVisible="{Binding Flight.IsForces}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Scenario_Caption}" />
                    <WrapPanel>
                        <Button Classes="chip" Command="{Binding Flight.ApplyScenarioCommand}" CommandParameter="Takeoff" Content="{loc:Localize Flight_Scenario_Takeoff}" />
                        <Button Classes="chip" Command="{Binding Flight.ApplyScenarioCommand}" CommandParameter="Climb" Content="{loc:Localize Flight_Scenario_Climb}" />
                        <Button Classes="chip" Command="{Binding Flight.ApplyScenarioCommand}" CommandParameter="Cruise" Content="{loc:Localize Flight_Scenario_Cruise}" />
                        <Button Classes="chip" Command="{Binding Flight.ApplyScenarioCommand}" CommandParameter="Glide" Content="{loc:Localize Flight_Scenario_Glide}" />
                        <Button Classes="chip" Command="{Binding Flight.ApplyScenarioCommand}" CommandParameter="Stall" Content="{loc:Localize Flight_Scenario_Stall}" />
                        <Button Classes="chip" Command="{Binding Flight.ApplyScenarioCommand}" CommandParameter="Landing" Content="{loc:Localize Flight_Scenario_Landing}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Controls_Caption}" />
                    <DockPanel Margin="0,4,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Flight.ThrottleText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Flight_Throttle}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Flight.Throttle}" SmallChange="0.01" LargeChange="0.1"
                            AutomationProperties.Name="{loc:Localize Flight_Throttle}" />
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Flight.PlaneAlphaText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Flight_PlaneAlpha}" />
                    </DockPanel>
                    <Slider Minimum="-5" Maximum="22" Value="{Binding Flight.PlaneAlpha}" SmallChange="0.1" LargeChange="1"
                            AutomationProperties.Name="{loc:Localize Flight_PlaneAlpha}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Classes="chip" Command="{Binding Flight.LevelOffCommand}" Content="{loc:Localize Flight_LevelOff}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Load_Caption}" />
                    <DockPanel Margin="0,4,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Flight.MassText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Flight_Mass}" />
                    </DockPanel>
                    <Slider Minimum="750" Maximum="1200" Value="{Binding Flight.Mass}" SmallChange="10" LargeChange="50"
                            IsSnapToTickEnabled="True" TickFrequency="10"
                            AutomationProperties.Name="{loc:Localize Flight_Mass}" />
                    <WrapPanel Margin="0,8,0,0">
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowLabels}" Content="{loc:Localize Flight_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Flight_Forces_Panel_Note}" />
                </StackPanel>

                <!-- Turn: what to show, the bank and the speed -->
                <StackPanel IsVisible="{Binding Flight.IsTurn}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Demo_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="FlightDemo" IsChecked="{Binding Flight.DemoChoice[Turn]}" Content="{loc:Localize Flight_Demo_Turn}" />
                        <RadioButton Classes="chip" GroupName="FlightDemo" IsChecked="{Binding Flight.DemoChoice[Roll]}" Content="{loc:Localize Flight_Demo_Roll}" />
                        <RadioButton Classes="chip" GroupName="FlightDemo" IsChecked="{Binding Flight.DemoChoice[Pitch]}" Content="{loc:Localize Flight_Demo_Pitch}" />
                        <RadioButton Classes="chip" GroupName="FlightDemo" IsChecked="{Binding Flight.DemoChoice[Yaw]}" Content="{loc:Localize Flight_Demo_Yaw}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Turn_Caption}" />
                    <DockPanel Margin="0,4,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Flight.BankText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Flight_Bank}" />
                    </DockPanel>
                    <Slider Minimum="-70" Maximum="70" Value="{Binding Flight.Bank}" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            AutomationProperties.Name="{loc:Localize Flight_Bank}" />
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Flight.TurnSpeedText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Flight_TurnSpeed}" />
                    </DockPanel>
                    <Slider Minimum="110" Maximum="300" Value="{Binding Flight.TurnSpeed}" SmallChange="5" LargeChange="20"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            AutomationProperties.Name="{loc:Localize Flight_TurnSpeed}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Classes="chip" Command="{Binding Flight.LevelWingsCommand}" Content="{loc:Localize Flight_LevelWings}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Flight.ShowLabels}" Content="{loc:Localize Flight_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Flight_Turn_Panel_Note}" />
                </StackPanel>

                <!-- The view's chart -->
                <SelectableTextBlock Classes="caption" Text="{Binding Flight.ChartCaption}" />
                <Border Classes="plate" Height="190">
                    <flight:FlightChart Mode="{Binding Flight.Mode}"
                                        Shape="{Binding Flight.Shape}"
                                        Inverted="{Binding Flight.Inverted}"
                                        Alpha="{Binding Flight.Alpha, Mode=TwoWay}"
                                        Mass="{Binding Flight.Mass}"
                                        Altitude="{Binding Flight.Altitude}"
                                        Speed="{Binding Flight.Speed}"
                                        Throttle="{Binding Flight.Throttle}"
                                        OnGround="{Binding Flight.OnGround}"
                                        TrimCommand="{Binding Flight.TrimCommand}"
                                        Bank="{Binding Flight.Bank, Mode=TwoWay}"
                                        TurnSpeed="{Binding Flight.TurnSpeed}"
                                        InteractionCommand="{Binding Flight.UserInteractedCommand}"
                                        AutomationProperties.Name="{Binding Flight.ChartCaption}" />
                </Border>
                <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{Binding Flight.ChartNote}" />

                <!-- What is happening now: a coloured edge for the state -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Flight.PhaseBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Flight.PhaseTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Flight.PhaseDescription}" />
                            <ItemsControl ItemsSource="{Binding Flight.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lessons:OscillationStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Flight_Facts}" />
                <ItemsControl ItemsSource="{Binding Flight.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
