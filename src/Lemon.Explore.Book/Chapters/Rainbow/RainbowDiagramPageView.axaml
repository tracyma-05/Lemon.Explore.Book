<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:rain="using:Lemon.Explore.Book.Chapters.Rainbow"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Rainbow.RainbowDiagramPageView"
                         x:DataType="rain:RainbowDiagramPageViewModel">
    <!-- Right page of the Rainbow spread: the diagram on a dark plate, the walkthrough and the view's main value. -->
    <explore:ChapterPageView.Styles>
        <Style Selector="Slider.toolbar">
            <Setter Property="Width" Value="130" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#D9DCE3" />
        </Style>
        <Style Selector="TextBlock.toolbarValue">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SpaceText}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <rain:RainbowDiagram Mode="{Binding Rainbow.Mode}"
                                     Scene="{Binding Rainbow.Scene}"
                                     Medium="{Binding Rainbow.Medium}"
                                     Colour="{Binding Rainbow.Colour}"
                                     FromInside="{Binding Rainbow.FromInside}"
                                     ShowWaves="{Binding Rainbow.ShowWaves}"
                                     Exaggerate="{Binding Rainbow.Exaggerate}"
                                     Order="{Binding Rainbow.Order}"
                                     ShowSheet="{Binding Rainbow.ShowSheet}"
                                     ShowLosses="{Binding Rainbow.ShowLosses}"
                                     DropSize="{Binding Rainbow.DropSize}"
                                     ShowSecondary="{Binding Rainbow.ShowSecondary}"
                                     ShowGuides="{Binding Rainbow.ShowGuides}"
                                     Angle="{Binding Rainbow.Angle, Mode=TwoWay}"
                                     Impact="{Binding Rainbow.Impact, Mode=TwoWay}"
                                     SunAltitude="{Binding Rainbow.SunAltitude, Mode=TwoWay}"
                                     IsPlaying="{Binding Rainbow.IsPlaying, Mode=TwoWay}"
                                     IsSweeping="{Binding Rainbow.IsSweeping, Mode=TwoWay}"
                                     ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                     Highlight="{Binding Rainbow.Lesson.Highlight}"
                                     IsLessonActive="{Binding Rainbow.Lesson.IsActive}"
                                     SelectedObject="{Binding Rainbow.Card.Id, Mode=TwoWay}"
                                     InteractionCommand="{Binding Rainbow.UserInteractedCommand}"
                                     ToolTip.Tip="{Binding Rainbow.DragHint}"
                                     AutomationProperties.Name="{Binding Rainbow.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Rainbow.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Rainbow.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Rainbow.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Rainbow.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Rain_PlayPause}" AutomationProperties.Name="{loc:Localize Rain_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Rainbow.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Rainbow.IsPlaying}" />
                                </Panel>
                            </Button>
                            <!-- Sweep the main value back and forth -->
                            <ToggleButton Classes="space" IsChecked="{Binding Rainbow.IsSweeping}" Content="{loc:Localize Rain_Sweep}"
                                          ToolTip.Tip="{loc:Localize Rain_Sweep}" AutomationProperties.Name="{loc:Localize Rain_Sweep}" />
                            <!-- The view's main value -->
                            <StackPanel Orientation="Horizontal" IsVisible="{Binding Rainbow.IsRefraction}">
                                <Slider Classes="toolbar" Minimum="0" Maximum="89" Value="{Binding Rainbow.Angle}" SmallChange="0.5" LargeChange="5"
                                        ToolTip.Tip="{loc:Localize Rain_Angle}" AutomationProperties.Name="{loc:Localize Rain_Angle}" />
                                <TextBlock Classes="toolbarValue" Text="{Binding Rainbow.AngleText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" IsVisible="{Binding Rainbow.IsDrop}">
                                <Slider Classes="toolbar" Minimum="0" Maximum="0.995" Value="{Binding Rainbow.Impact}" SmallChange="0.005" LargeChange="0.05"
                                        ToolTip.Tip="{loc:Localize Rain_Impact}" AutomationProperties.Name="{loc:Localize Rain_Impact}" />
                                <TextBlock Classes="toolbarValue" Text="{Binding Rainbow.ImpactText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" IsVisible="{Binding Rainbow.IsSky}">
                                <Slider Classes="toolbar" Minimum="0" Maximum="60" Value="{Binding Rainbow.SunAltitude}" SmallChange="0.5" LargeChange="5"
                                        ToolTip.Tip="{loc:Localize Rain_SunAltitude}" AutomationProperties.Name="{loc:Localize Rain_SunAltitude}" />
                                <TextBlock Classes="toolbarValue" Text="{Binding Rainbow.SunAltitudeText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
