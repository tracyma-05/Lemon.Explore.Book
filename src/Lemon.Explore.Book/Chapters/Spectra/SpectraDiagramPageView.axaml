<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:spectra="using:Lemon.Explore.Book.Chapters.Spectra"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Spectra.SpectraDiagramPageView"
                         x:DataType="spectra:SpectraDiagramPageViewModel">
    <!-- Right page of the Spectra spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <spectra:SpectraDiagram Mode="{Binding Spectra.Mode}"
                                        Level="{Binding Spectra.Level, Mode=TwoWay}"
                                        FallMode="{Binding Spectra.FallMode}"
                                        Hold="{Binding Spectra.Hold}"
                                        PhotonNm="{Binding Spectra.PhotonNm, Mode=TwoWay}"
                                        FireCount="{Binding Spectra.FireCount}"
                                        ClearCount="{Binding Spectra.ClearCount}"
                                        ShowCloud="{Binding Spectra.ShowCloud}"
                                        CloudShape="{Binding Spectra.CloudShape}"
                                        LastEvent="{Binding Spectra.LastEvent, Mode=TwoWay}"
                                        Source="{Binding Spectra.Source}"
                                        Gas="{Binding Spectra.Gas}"
                                        Mystery="{Binding Spectra.Mystery}"
                                        CompareGas="{Binding Spectra.CompareGas}"
                                        SelectedLine="{Binding Spectra.SelectedLine, Mode=TwoWay}"
                                        Zoom="{Binding Spectra.Zoom}"
                                        Kelvin="{Binding Spectra.Kelvin, Mode=TwoWay}"
                                        Velocity="{Binding Spectra.Velocity, Mode=TwoWay}"
                                        ShowLabels="{Binding Spectra.ShowLabels}"
                                        IsPlaying="{Binding Spectra.IsPlaying, Mode=TwoWay}"
                                        ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                        Highlight="{Binding Spectra.Lesson.Highlight}"
                                        IsLessonActive="{Binding Spectra.Lesson.IsActive}"
                                        SelectedObject="{Binding Spectra.Card.Id, Mode=TwoWay}"
                                        InteractionCommand="{Binding Spectra.UserInteractedCommand}"
                                        ToolTip.Tip="{Binding Spectra.Hint}"
                                        AutomationProperties.Name="{Binding Spectra.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Spectra.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Spectra.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Spectra.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Spectra.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Spec_PlayPause}" AutomationProperties.Name="{loc:Localize Spec_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Spectra.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Spectra.IsPlaying}" />
                                </Panel>
                            </Button>
                            <ToggleButton Classes="space" IsChecked="{Binding Spectra.ShowLabels}" Content="{loc:Localize Spec_Option_Labels}" />
                            <Button Classes="space" Command="{Binding Spectra.FireCommand}" IsVisible="{Binding Spectra.IsAtom}"
                                    Content="{loc:Localize Spec_Fire}" ToolTip.Tip="{loc:Localize Spec_Fire_Tooltip}" />
                            <Button Classes="space" Command="{Binding Spectra.NewMysteryCommand}" IsVisible="{Binding Spectra.IsLamps}"
                                    Content="{loc:Localize Spec_Mystery}" ToolTip.Tip="{loc:Localize Spec_Mystery_Tooltip}" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
