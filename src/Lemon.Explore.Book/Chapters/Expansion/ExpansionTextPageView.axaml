<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:expansion="using:Lemon.Explore.Book.Chapters.Expansion"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:lessons="using:Lemon.Explore.Book.Explore.Lessons"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Expansion.ExpansionTextPageView"
                         x:DataType="expansion:ExpansionTextPageViewModel">
    <!-- Left page of the Expansion spread: the view's settings, its chart, and what is happening. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Expansion.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Expansion.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Expansion.Hint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="ExpansionMode" IsChecked="{Binding Expansion.IsHubble}" Content="{loc:Localize Expand_Mode_Hubble}" />
                    <RadioButton Classes="chip" GroupName="ExpansionMode" IsChecked="{Binding Expansion.IsRedshift}" Content="{loc:Localize Expand_Mode_Redshift}" />
                    <RadioButton Classes="chip" GroupName="ExpansionMode" IsChecked="{Binding Expansion.IsHistory}" Content="{loc:Localize Expand_Mode_History}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Expansion.Card}" />

                <!-- Hubble: the moment, home and what to show -->
                <StackPanel IsVisible="{Binding Expansion.IsHubble}">
                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Expansion.HubbleWhenText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Expand_HubbleTime}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Expansion.HubbleProgress}" SmallChange="0.01" LargeChange="0.1"
                            AutomationProperties.Name="{loc:Localize Expand_HubbleTime}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Classes="chip" Command="{Binding Expansion.RestartSpanCommand}" Content="{loc:Localize Expand_RestartSpan}" />
                        <Button Classes="chip" Command="{Binding Expansion.GoHomeCommand}" Content="{loc:Localize Expand_GoHome}"
                                IsEnabled="{Binding Expansion.IsAwayFromHome}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Expand_Show_Caption}" />
                    <WrapPanel>
                        <ToggleButton Classes="chip" IsChecked="{Binding Expansion.ShowArrows}" Content="{loc:Localize Expand_Option_Arrows}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Expansion.ShowRulers}" Content="{loc:Localize Expand_Option_Rulers}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Expansion.ShowOverlay}" Content="{loc:Localize Expand_Option_Overlay}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Expansion.ShowGrid}" Content="{loc:Localize Expand_Option_Grid}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Expansion.ShowLabels}" Content="{loc:Localize Expand_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Expand_Hubble_Panel_Note}" />
                </StackPanel>

                <!-- Redshift: which galaxy, its redshift and the light's journey -->
                <StackPanel IsVisible="{Binding Expansion.IsRedshift}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Expand_Source_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="ExpansionSource" IsChecked="{Binding Expansion.SourceChoice[Virgo]}" Content="{loc:Localize Expand_Source_Virgo}" />
                        <RadioButton Classes="chip" GroupName="ExpansionSource" IsChecked="{Binding Expansion.SourceChoice[Coma]}" Content="{loc:Localize Expand_Source_Coma}" />
                        <RadioButton Classes="chip" GroupName="ExpansionSource" IsChecked="{Binding Expansion.SourceChoice[Quasar]}" Content="{loc:Localize Expand_Source_Quasar}" />
                        <RadioButton Classes="chip" GroupName="ExpansionSource" IsChecked="{Binding Expansion.SourceChoice[Halfway]}" Content="{loc:Localize Expand_Source_Halfway}" />
                        <RadioButton Classes="chip" GroupName="ExpansionSource" IsChecked="{Binding Expansion.SourceChoice[GnZ11]}" Content="{loc:Localize Expand_Source_GnZ11}" />
                        <RadioButton Classes="chip" GroupName="ExpansionSource" IsChecked="{Binding Expansion.SourceChoice[Jades]}" Content="{loc:Localize Expand_Source_Jades}" />
                    </WrapPanel>

                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Expansion.RedshiftText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Expand_Redshift}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Expansion.RedshiftSlider}" SmallChange="0.005" LargeChange="0.05"
                            AutomationProperties.Name="{loc:Localize Expand_Redshift}" />
                    <DockPanel Margin="0,10,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Expansion.JourneyText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Expand_Journey}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Expansion.Journey}" SmallChange="0.01" LargeChange="0.1"
                            AutomationProperties.Name="{loc:Localize Expand_Journey}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Classes="chip" Command="{Binding Expansion.ReplayCommand}" Content="{loc:Localize Expand_Replay}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Expansion.ShowLabels}" Content="{loc:Localize Expand_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Expand_Redshift_Panel_Note}" />
                </StackPanel>

                <!-- History: which universe, the time axis and the moment -->
                <StackPanel IsVisible="{Binding Expansion.IsHistory}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Expand_Universe_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="ExpansionUniverse" IsChecked="{Binding Expansion.UniverseChoice[Ours]}" Content="{loc:Localize Expand_Universe_Ours}" />
                        <RadioButton Classes="chip" GroupName="ExpansionUniverse" IsChecked="{Binding Expansion.UniverseChoice[MatterOnly]}" Content="{loc:Localize Expand_Universe_MatterOnly}" />
                        <RadioButton Classes="chip" GroupName="ExpansionUniverse" IsChecked="{Binding Expansion.UniverseChoice[Closed]}" Content="{loc:Localize Expand_Universe_Closed}" />
                    </WrapPanel>

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Expand_Axis_Caption}" />
                    <WrapPanel>
                        <RadioButton Classes="chip" GroupName="ExpansionAxis" IsChecked="{Binding Expansion.AxisChoice[Linear]}" Content="{loc:Localize Expand_Axis_LinearChip}" />
                        <RadioButton Classes="chip" GroupName="ExpansionAxis" IsChecked="{Binding Expansion.AxisChoice[Log]}" Content="{loc:Localize Expand_Axis_LogChip}" />
                    </WrapPanel>

                    <DockPanel Margin="0,14,0,2">
                        <SelectableTextBlock Classes="value" Text="{Binding Expansion.CosmicTimeText}" />
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Expand_Moment}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Expansion.TimeSlider}" SmallChange="0.005" LargeChange="0.05"
                            AutomationProperties.Name="{loc:Localize Expand_Moment}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Classes="chip" Command="{Binding Expansion.JumpToCommand}" CommandParameter="Start" Content="{loc:Localize Expand_Jump_Start}" />
                        <Button Classes="chip" Command="{Binding Expansion.JumpToCommand}" CommandParameter="Cmb" Content="{loc:Localize Expand_Jump_Cmb}" />
                        <Button Classes="chip" Command="{Binding Expansion.JumpToCommand}" CommandParameter="Now" Content="{loc:Localize Expand_Jump_Now}" />
                        <Button Classes="chip" Command="{Binding Expansion.JumpToCommand}" CommandParameter="Future" Content="{loc:Localize Expand_Jump_Future}" />
                        <ToggleButton Classes="chip" IsChecked="{Binding Expansion.ShowLabels}" Content="{loc:Localize Expand_Option_Labels}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Expand_History_Panel_Note}" />
                </StackPanel>

                <!-- The view's chart -->
                <SelectableTextBlock Classes="caption" Text="{Binding Expansion.ChartCaption}" />
                <Border Classes="plate" Height="200">
                    <expansion:ExpansionChart Mode="{Binding Expansion.Mode}"
                                              HubbleProgress="{Binding Expansion.HubbleProgress}"
                                              Home="{Binding Expansion.Home}"
                                              Redshift="{Binding Expansion.Redshift, Mode=TwoWay}"
                                              Journey="{Binding Expansion.Journey}"
                                              Universe="{Binding Expansion.UniverseKind, Mode=TwoWay}"
                                              CosmicTime="{Binding Expansion.CosmicTime, Mode=TwoWay}"
                                              InteractionCommand="{Binding Expansion.UserInteractedCommand}"
                                              AutomationProperties.Name="{Binding Expansion.ChartCaption}" />
                </Border>
                <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{Binding Expansion.ChartNote}" />

                <!-- What is happening now: a coloured edge for the phase -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Expansion.PhaseBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InkBrush}" Text="{Binding Expansion.PhaseTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Expansion.PhaseDescription}" />
                            <ItemsControl ItemsSource="{Binding Expansion.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lessons:OscillationStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Expand_Facts}" />
                <ItemsControl ItemsSource="{Binding Expansion.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
