<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:typhoon="using:Lemon.Explore.Book.Chapters.Typhoon"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Typhoon.TyphoonDiagramPageView"
                         x:DataType="typhoon:TyphoonDiagramPageViewModel">
    <!-- Right page of the Typhoon spread: the diagram on a dark plate, the walkthrough and playback. -->
    <explore:ChapterPageView.Styles>
        <Style Selector="RadioButton.speed">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <typhoon:TyphoonDiagram Mode="{Binding Typhoon.Mode}"
                                        CentralPressure="{Binding Typhoon.CentralPressure}"
                                        Southern="{Binding Typhoon.Southern}"
                                        Spin="{Binding Typhoon.Spin}"
                                        Moving="{Binding Typhoon.Moving}"
                                        ShowIsobars="{Binding Typhoon.ShowIsobars}"
                                        ProbeX="{Binding Typhoon.ProbeX, Mode=TwoWay}"
                                        ProbeY="{Binding Typhoon.ProbeY, Mode=TwoWay}"
                                        SeaTemperature="{Binding Typhoon.SeaTemperature}"
                                        Landfall="{Binding Typhoon.Landfall}"
                                        LandfallHours="{Binding Typhoon.LandfallHours, Mode=TwoWay}"
                                        Month="{Binding Typhoon.Month}"
                                        RidgeWest="{Binding Typhoon.RidgeWest}"
                                        StartLatitude="{Binding Typhoon.StartLatitude, Mode=TwoWay}"
                                        StartLongitude="{Binding Typhoon.StartLongitude, Mode=TwoWay}"
                                        TrackHour="{Binding Typhoon.TrackHour, Mode=TwoWay}"
                                        PlaceLatitude="{Binding Typhoon.PlaceLatitude}"
                                        PlaceLongitude="{Binding Typhoon.PlaceLongitude}"
                                        PlaceName="{Binding Typhoon.PlaceName}"
                                        ShowLabels="{Binding Typhoon.ShowLabels}"
                                        Speed="{Binding Typhoon.Speed}"
                                        IsPlaying="{Binding Typhoon.IsPlaying, Mode=TwoWay}"
                                        ToolbarHeight="{Binding #Toolbar.Bounds.Height}"
                                        Highlight="{Binding Typhoon.Lesson.Highlight}"
                                        IsLessonActive="{Binding Typhoon.Lesson.IsActive}"
                                        SelectedObject="{Binding Typhoon.Card.Id, Mode=TwoWay}"
                                        InteractionCommand="{Binding Typhoon.UserInteractedCommand}"
                                        ToolTip.Tip="{Binding Typhoon.Hint}"
                                        AutomationProperties.Name="{Binding Typhoon.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Typhoon.Lesson}" />
                    <Border x:Name="Toolbar" HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Typhoon.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Typhoon.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Typhoon.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Typhoon_PlayPause}" AutomationProperties.Name="{loc:Localize Typhoon_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Typhoon.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Typhoon.IsPlaying}" />
                                </Panel>
                            </Button>
                            <!-- Playback speed -->
                            <StackPanel Margin="2,0" Orientation="Horizontal" ToolTip.Tip="{loc:Localize Typhoon_Speed}">
                                <RadioButton Classes="space speed" GroupName="TyphoonSpeed" Content="¼×" IsChecked="{Binding Typhoon.SpeedChoice[0.25]}" />
                                <RadioButton Classes="space speed" GroupName="TyphoonSpeed" Content="½×" IsChecked="{Binding Typhoon.SpeedChoice[0.5]}" />
                                <RadioButton Classes="space speed" GroupName="TyphoonSpeed" Content="1×" IsChecked="{Binding Typhoon.SpeedChoice[1]}" />
                                <RadioButton Classes="space speed" GroupName="TyphoonSpeed" Content="2×" IsChecked="{Binding Typhoon.SpeedChoice[2]}" />
                            </StackPanel>
                            <!-- The timelines: hours after landfall, the storm's life -->
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="130" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="{Binding Typhoon.LandfallSpan}" Value="{Binding Typhoon.LandfallHours}" SmallChange="1" LargeChange="6"
                                        ToolTip.Tip="{loc:Localize Typhoon_Timeline_Landfall}" AutomationProperties.Name="{loc:Localize Typhoon_Timeline_Landfall}">
                                    <Slider.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Typhoon.IsEngine" />
                                            <Binding Path="Typhoon.Landfall" />
                                        </MultiBinding>
                                    </Slider.IsVisible>
                                </Slider>
                                <Slider Width="130" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="{Binding Typhoon.TrackLength}" Value="{Binding Typhoon.TrackHour}" SmallChange="1" LargeChange="12"
                                        IsVisible="{Binding Typhoon.IsTrack}"
                                        ToolTip.Tip="{loc:Localize Typhoon_Timeline_Track}" AutomationProperties.Name="{loc:Localize Typhoon_Timeline_Track}" />
                                <TextBlock MinWidth="120" Margin="6,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource SpaceText}" Text="{Binding Typhoon.ClockText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
