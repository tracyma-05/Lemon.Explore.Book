<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:tides="using:Lemon.Explore.Book.Chapters.Tides"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Tides.TidesTextPageView"
                         x:DataType="tides:TidesTextPageViewModel">
    <!-- Left page of the Tides spread: each view's own pictures, the tide now, today's tides and the coming ones. -->
    <explore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).statName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).statValue">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).tideName">
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#B07A2A" />
        </Style>
        <Style Selector=":is(TextBlock).tideName.high">
            <Setter Property="Foreground" Value="#2C7FB8" />
        </Style>
        <Style Selector="Rectangle.legend">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="2.5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(TextBlock).legend">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BodyInkBrush}" />
        </Style>
    </explore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{Binding Tides.Subtitle}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{Binding Tides.ScaleNote}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{Binding Tides.DragHint}" />
                <SelectableTextBlock Classes="note" Margin="0,2,0,0" Text="{loc:Localize Explore_ClickHint}" />

                <WrapPanel Margin="0,14,0,0">
                    <RadioButton Classes="chip" GroupName="TidesMode" IsChecked="{Binding Tides.IsBulges}"
                                 Content="{loc:Localize Tides_Mode_Bulges}" />
                    <RadioButton Classes="chip" GroupName="TidesMode" IsChecked="{Binding Tides.IsSpringNeap}"
                                 Content="{loc:Localize Tides_Mode_SpringNeap}" />
                    <RadioButton Classes="chip" GroupName="TidesMode" IsChecked="{Binding Tides.IsCoast}"
                                 Content="{loc:Localize Tides_Mode_Coast}" />
                </WrapPanel>

                <explore:ObjectCardView Margin="0,10,0,0" DataContext="{Binding Tides.Card}" />

                <explore:LocationChip Margin="0,14,0,0" Service="{Binding Tides.Location}" />

                <!-- Two bulges: why the far side bulges too, and the water where you are -->
                <StackPanel IsVisible="{Binding Tides.IsBulges}">
                    <WrapPanel Margin="0,14,0,0">
                        <ToggleButton Classes="chip" IsChecked="{Binding Tides.ShowForces}"
                                      Content="{loc:Localize Tides_ShowForces}" />
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_Force_Caption}" />
                    <Border Classes="plate" Height="260">
                        <tides:TidalForceView AutomationProperties.Name="{loc:Localize Tides_Force_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Tides_Force_Note}" />

                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_Chart_Caption_Moon}" />
                    <Border Classes="plate" Height="170">
                        <tides:TideChart Day="{Binding Tides.Day}" IncludeSun="False" ShowMetres="False"
                                         AutomationProperties.Name="{loc:Localize Tides_Chart_Caption_Moon}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Tides_Chart_Note_Moon}" />
                </StackPanel>

                <!-- Spring and neap: what the outlines are, and the range through the month -->
                <StackPanel IsVisible="{Binding Tides.IsSpringNeap}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_Legend_Caption}" />
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                            <Rectangle Classes="legend" Fill="#4A9BD8" Height="8" />
                            <SelectableTextBlock Classes="legend" Text="{loc:Localize Tides_Legend_Water}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                            <Rectangle Classes="legend" Fill="#7C8CD6" />
                            <SelectableTextBlock Classes="legend" Text="{loc:Localize Tides_Legend_Moon}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                            <Rectangle Classes="legend" Fill="#E0A82E" />
                            <SelectableTextBlock Classes="legend" Text="{loc:Localize Tides_Legend_Sun}" />
                        </StackPanel>
                    </WrapPanel>
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_Range_Caption}" />
                    <Border Classes="plate" Height="170">
                        <tides:TideRangeChart Day="{Binding Tides.Day}" AutomationProperties.Name="{loc:Localize Tides_Range_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Tides_Range_Note}" />
                </StackPanel>

                <!-- At the coast: the tide curve and today's tide table -->
                <StackPanel IsVisible="{Binding Tides.IsCoast}">
                    <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_Chart_Caption}" />
                    <Border Classes="plate" Height="170">
                        <tides:TideChart Day="{Binding Tides.Day}" AutomationProperties.Name="{loc:Localize Tides_Chart_Caption}" />
                    </Border>
                    <SelectableTextBlock Classes="note" Margin="0,8,0,0" Text="{loc:Localize Tides_Chart_Note}" />
                    <SelectableTextBlock Classes="caption" Text="{Binding Tides.TodayTidesCaption}" />
                    <ItemsControl ItemsSource="{Binding Tides.TodayTides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tides:TideTableRow">
                                <Grid ColumnDefinitions="80,60,*">
                                    <SelectableTextBlock Classes="tideName" Classes.high="{Binding IsHigh}" Text="{Binding Name}" />
                                    <SelectableTextBlock Grid.Column="1" Classes="statName" Foreground="{DynamicResource InkBrush}" Text="{Binding Time}" />
                                    <SelectableTextBlock Grid.Column="2" Classes="statValue" Text="{Binding Height}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- What is happening now: a coloured edge for the tide -->
                <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource TintBrush}" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" Background="{Binding Tides.StageBrush}" />
                        <StackPanel Margin="14,12">
                            <SelectableTextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkBrush}" Text="{Binding Tides.StageTitle}" />
                            <SelectableTextBlock Classes="text" Margin="0,6,0,10" Text="{Binding Tides.StageDescription}" />
                            <ItemsControl ItemsSource="{Binding Tides.Stats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tides:TideStat">
                                        <Grid ColumnDefinitions="130,*">
                                            <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                            <SelectableTextBlock Classes="statValue" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_JumpTo}" />
                <WrapPanel>
                    <Button Classes="chip" Command="{Binding Tides.JumpToCommand}" CommandParameter="New"
                            Content="{loc:Localize MoonPhases_Phase_New}" />
                    <Button Classes="chip" Command="{Binding Tides.JumpToCommand}" CommandParameter="FirstQuarter"
                            Content="{loc:Localize MoonPhases_Phase_FirstQuarter}" />
                    <Button Classes="chip" Command="{Binding Tides.JumpToCommand}" CommandParameter="Full"
                            Content="{loc:Localize MoonPhases_Phase_Full}" />
                    <Button Classes="chip" Command="{Binding Tides.JumpToCommand}" CommandParameter="LastQuarter"
                            Content="{loc:Localize MoonPhases_Phase_LastQuarter}" />
                    <Button Classes="chip" Command="{Binding Tides.JumpToCommand}" CommandParameter="Today"
                            Content="{loc:Localize Tides_Today}" />
                    <Button Classes="chip" Command="{Binding Tides.JumpToCommand}" CommandParameter="NextHigh"
                            IsVisible="{Binding Tides.ShowsTideTimes}" Content="{loc:Localize Tides_NextHigh}" />
                    <Button Classes="chip" Command="{Binding Tides.JumpToCommand}" CommandParameter="NextLow"
                            IsVisible="{Binding Tides.ShowsTideTimes}" Content="{loc:Localize Tides_NextLow}" />
                </WrapPanel>

                <!-- The real Moon: today and the coming spring and neap tides -->
                <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_Upcoming}" />
                <SelectableTextBlock Classes="text" Margin="0,0,0,6" Text="{Binding Tides.TodayText}" />
                <ItemsControl ItemsSource="{Binding Tides.Upcoming}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tides:UpcomingTide">
                            <Grid ColumnDefinitions="140,*">
                                <SelectableTextBlock Classes="statName" Text="{Binding Name}" />
                                <SelectableTextBlock Classes="statValue" Text="{Binding When}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{loc:Localize Tides_Upcoming_Note}" />

                <SelectableTextBlock Classes="caption" Text="{loc:Localize Tides_Facts}" />
                <ItemsControl ItemsSource="{Binding Tides.Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                <Ellipse Width="5" Height="5" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AccentBrush}" />
                                <SelectableTextBlock Grid.Column="1" Classes="text" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="chip" HorizontalAlignment="Left" Command="{Binding Tides.OpenMoonPhasesCommand}"
                        Content="{loc:Localize Tides_OpenMoonPhases}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
