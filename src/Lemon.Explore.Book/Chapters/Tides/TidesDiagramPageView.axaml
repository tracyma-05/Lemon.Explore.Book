<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:tides="using:Lemon.Explore.Book.Chapters.Tides"
                         xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
                         xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
                         x:Class="Lemon.Explore.Book.Chapters.Tides.TidesDiagramPageView"
                         x:DataType="tides:TidesDiagramPageViewModel">
    <!-- Right page of the Tides spread: the diagram on a dark plate, the walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <tides:TidesDiagram Mode="{Binding Tides.Mode}"
                                    Day="{Binding Tides.Day, Mode=TwoWay}"
                                    IsPlaying="{Binding Tides.IsPlaying, Mode=TwoWay}"
                                    ShowForces="{Binding Tides.ShowForces}"
                                    CoastLatitude="{Binding Tides.CoastLatitude}"
                                    Highlight="{Binding Tides.Lesson.Highlight}"
                                    IsLessonActive="{Binding Tides.Lesson.IsActive}"
                                    SelectedObject="{Binding Tides.Card.Id, Mode=TwoWay}"
                                    InteractionCommand="{Binding Tides.UserInteractedCommand}"
                                    ToolTip.Tip="{Binding Tides.DragHint}"
                                    AutomationProperties.Name="{Binding Tides.Subtitle}" />

                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Tides.Lesson}" />
                    <Border HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Tides.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Tides.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Tides.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Tides_PlayPause}"
                                    AutomationProperties.Name="{loc:Localize Tides_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Tides.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Tides.IsPlaying}" />
                                </Panel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <!-- Timeline: days since new moon. -->
                                <Slider Width="150" Margin="6,0" VerticalAlignment="Center" Foreground="#D9DCE3"
                                        Minimum="0" Maximum="{Binding Tides.MonthLength}" Value="{Binding Tides.Day}"
                                        SmallChange="0.0417" LargeChange="1"
                                        ToolTip.Tip="{loc:Localize Tides_Timeline}"
                                        AutomationProperties.Name="{loc:Localize Tides_Timeline}" />
                                <TextBlock MinWidth="96" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource SpaceText}" Text="{Binding Tides.ClockText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
