<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:seasons="using:Lemon.Explore.Book.Chapters.Seasons"
             xmlns:explore="using:Lemon.Explore.Book.Controls.Explore"
             xmlns:loc="using:Lemon.Explore.Book.Infrastructures.Localization"
             x:Class="Lemon.Explore.Book.Chapters.Seasons.SeasonsDiagramPageView"
             x:DataType="seasons:SeasonsDiagramPageViewModel">
    <!-- Right page of the seasons spread: the animated diagram on a dark plate, its walkthrough and playback. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12">
            <Grid>
                <seasons:SeasonsDiagram Mode="{Binding Seasons.Mode}"
                                        Day="{Binding Seasons.Day}"
                                        TimeOfDay="{Binding Seasons.TimeOfDay}"
                                        IsPlaying="{Binding Seasons.IsPlaying}"
                                        AnimatesYear="{Binding Seasons.AnimatesYear}"
                                        Latitude="{Binding Seasons.Latitude}"
                                        Tilt="{Binding Seasons.Tilt}"
                                        Highlight="{Binding Seasons.Lesson.Highlight}"
                                        IsLessonActive="{Binding Seasons.Lesson.IsActive}"
                                        SelectedObject="{Binding Seasons.Card.Id}"
                                        InteractionCommand="{Binding Seasons.UserInteractedCommand}"
                                        ToolTip.Tip="{Binding Seasons.DragHint}"
                                        AutomationProperties.Name="{Binding Seasons.Subtitle}" />

                <!-- The walkthrough's subtitles, and playback under them -->
                <StackPanel Margin="12,0,12,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <explore:LessonPanel Margin="0,0,0,8" DataContext="{Binding Seasons.Lesson}" />
                    <Border HorizontalAlignment="Center" Padding="6,4"
                            Background="{StaticResource SpaceGlass}" BorderBrush="{StaticResource SpaceGlassBorder}"
                            BorderThickness="1" CornerRadius="22">
                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Classes="space"
                                          IsChecked="{Binding Seasons.Lesson.IsActive, Mode=OneWay}"
                                          Command="{Binding Seasons.Lesson.ToggleCommand}"
                                          ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                                          AutomationProperties.Name="{loc:Localize Lesson_Start}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Voice}" />
                                    <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Classes="space" Command="{Binding Seasons.TogglePlayCommand}"
                                    ToolTip.Tip="{loc:Localize Seasons_PlayPause}"
                                    AutomationProperties.Name="{loc:Localize Seasons_PlayPause}">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Pause}" IsVisible="{Binding Seasons.IsPlaying}" />
                                    <PathIcon Data="{StaticResource Icon.Play}" IsVisible="{Binding !Seasons.IsPlaying}" />
                                </Panel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <!-- Timeline: the day of the year. -->
                                <Slider Width="150" Margin="6,0" VerticalAlignment="Center"
                                        Foreground="#7FB2FF"
                                        Minimum="0" Maximum="{Binding Seasons.YearLength}" Value="{Binding Seasons.Day}"
                                        SmallChange="1" LargeChange="15"
                                        ToolTip.Tip="{loc:Localize Seasons_Timeline}"
                                        AutomationProperties.Name="{loc:Localize Seasons_Timeline}" />
                                <TextBlock MinWidth="60" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource SpaceText}" Text="{Binding Seasons.DateText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</UserControl>
