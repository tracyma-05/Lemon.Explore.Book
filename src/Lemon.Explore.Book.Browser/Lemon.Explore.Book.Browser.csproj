<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Web head: Avalonia on WebAssembly, served as an installable, offline-capable PWA (see wwwroot). -->

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Lemon.Explore.Book.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!--
      Compile to WebAssembly ahead of time. Interpreted, the diagrams' per-pixel renderers (globes, skies, planet
      textures) cannot keep up with the frame rate and the whole tab stutters. Costs a longer publish and a larger
      download; the IL left behind after AOT is stripped to win some of that back.
    -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The browser has no system fonts to fall back on, so the book carries its own CJK font. These are the full
      Noto Sans SC files; subsetting them to the characters the book uses is on the roadmap.
    -->
    <AvaloniaResource Include="Assets\Fonts\*.otf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lemon.Explore.Book\Lemon.Explore.Book.csproj" />
  </ItemGroup>

</Project>
