<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      A shell version being tried before it is on nuget.org: Lemon.Book.Shell's scripts/pack.sh puts it here
      (git-ignored). Published versions come from nuget.org, so a fresh clone needs nothing here.
    -->
    <add key="local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Lemon.Book.Shell*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Lemon.Book.Shell*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
